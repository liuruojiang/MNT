+def _verify_dbmf_factor_basis(dates, quote, adjusted, require_complete=False):
+    """Frozen actions through 2026-10-23; unknown/mixed future seams fail closed."""
+    try:
+        if len(quote['close']) != len(dates) or len(adjusted) != len(dates):
+            raise ValueError('length mismatch')
+        raw = np.asarray(quote['close'], dtype=float)
+        adj = np.asarray(adjusted, dtype=float)
+    except (KeyError, TypeError, ValueError, IndexError) as exc:
+        raise VerifiedDataRepairConflict('DBMF factor input schema invalid') from exc
+    valid = np.isfinite(raw) & np.isfinite(adj) & (raw > 0) & (adj > 0)
+    paired_missing = np.isnan(raw) & np.isnan(adj)
+    if not (valid | paired_missing).all():
+        raise VerifiedDataRepairConflict('DBMF invalid/partial price pair')
+    positions = np.flatnonzero(valid)
+    for prior, current in zip(positions[:-1], positions[1:]):
+        day = dates[current].date().isoformat()
+        if current != prior + 1 and any(dates[prior] < pd.Timestamp(action) <= dates[current] for action in _DBMF_VERIFIED_ACTIONS):
+            raise VerifiedDataRepairConflict('DBMF cannot verify action across missing session')
+        ratio = (adj[prior] / raw[prior]) / (adj[current] / raw[current])
+        allowed = _DBMF_VERIFIED_ACTIONS.get(day)
+        if allowed is None:
+            if abs(ratio - 1) > 2e-6:
+                raise VerifiedDataRepairConflict('DBMF mixed factor or unknown action on ' + day)
+        else:
+            if require_complete and day == '2026-09-29':
+                allowed = [0.1456]
+            implied = raw[prior] * (1 - ratio)
+            if min(abs(implied - value) for value in allowed) > 5e-5:
+                raise VerifiedDataRepairConflict('DBMF factor conflicts on ' + day)
