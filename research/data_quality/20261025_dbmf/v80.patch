+def _repair_verified_dbmf_distribution(ticker, timestamps, quote, adjusted):
+    """Issuer total-return curve plus broker notice corroborate USD 0.1456.
+
+    https://www.imgp.com/us/fund/us53700t8273-imgp-dbi-managed-futures-strategy-etf/
+    https://www.esunsec.com.tw/foreignstock/rate
+    Only repair the observed zero cash-factor seam; preserve Yahoo convention.
+    """
+    if ticker != 'DBMF':
+        return adjusted, ''
+    if not isinstance(timestamps, (list, tuple, np.ndarray)) or any(isinstance(t, (bool, np.bool_)) or not isinstance(t, (int, float, np.integer, np.floating)) or not np.isfinite(t) for t in timestamps):
+        raise VerifiedDataRepairConflict('DBMF invalid raw timestamps')
+    dates = pd.to_datetime(timestamps, unit='s', utc=True).tz_localize(None).normalize()
+    if dates.hasnans or dates.has_duplicates or not dates.is_monotonic_increasing:
+        raise VerifiedDataRepairConflict('DBMF duplicate/invalid factor dates')
+    if not len(dates):
+        return adjusted, ''
+    _verify_dbmf_factor_basis(dates, quote, adjusted)
+    ex, prior = pd.Timestamp('2026-09-29'), pd.Timestamp('2026-09-28')
+    if dates.max() < ex or dates.min() >= ex:
+        return adjusted, ''
+    if prior not in dates or ex not in dates:
+        raise VerifiedDataRepairConflict('DBMF distribution anchors missing')
+    ip, ie = dates.get_loc(prior), dates.get_loc(ex)
+    try:
+        p, e, ap, ae = [float(v) for v in (quote['close'][ip], quote['close'][ie], adjusted[ip], adjusted[ie])]
+    except (TypeError, ValueError, IndexError, KeyError) as exc:
+        raise VerifiedDataRepairConflict('DBMF distribution anchors invalid') from exc
+    if not all(np.isfinite(v) and v > 0 for v in (p, e, ap, ae)) or p <= 0.1456:
+        raise VerifiedDataRepairConflict('DBMF unusable distribution anchors')
+    observed = (ap / p) / (ae / e)
+    implied = p * (1 - observed)
+    if abs(implied - 0.1456) <= 5e-5:
+        return adjusted, 'DBMF-20260929-upstream-complete'
+    if abs(implied) > 5e-5:
+        raise VerifiedDataRepairConflict('DBMF unrecognized distribution factor')
+    out = list(adjusted)
+    scale = (1 - 0.1456 / p) / observed
+    for i in np.flatnonzero(dates < ex):
+        if out[i] is not None:
+            out[i] = float(out[i]) * scale
+    _verify_dbmf_factor_basis(dates, quote, out, require_complete=True)
+    return out, 'DBMF-20260929-verified-income-repair'
