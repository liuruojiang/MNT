+    today = pd.Timestamp(clock.date())
+    required = pd.Timestamp(required_close)
+    if not _is_cn_unconfirmed_at(clock) or required >= today:
+        return cn_raw
+    latest = {code: _latest_valid_close_date(cn_raw.get(code)) for code in columns}
