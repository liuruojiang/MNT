4;total&#34;:&#34;100.00&#34;,&#34;isavailable&#34;:true,&#34;exposure&#34;:[{&#34;name&#34;:&#34;Under 1 Year&#34;,&#34;value&#34;:&#34;0.0235998&#34;},{&#34;name&#34;:&#34;1 - 5 Years&#34;,&#34;value&#34;:&#34;50.5814625&#34;},{&#34;name&#34;:&#34;5 - 10 Years&#34;,&#34;value&#34;:&#34;49.3949377&#34;}],&#34;fundShortName&#34;:&#34;IT Treasury ETF&#34;,&#34;averageMaturityType&#34;:&#34;E&#34;,&#34;asOfDate&#34;:&#34;09/30/2026&#34;},&#34;sectorExposure&#34;:{&#34;isavailable&#34;:false},&#34;allocationUnderlyingFunds&#34;:{&#34;isavailable&#34;:false},&#34;asOfDate&#34;:&#34;09/30/2026&#34;,&#34;region&#34;:{&#34;isavailable&#34;:false},&#34;issuer&#34;:{&#34;total&#34;:&#34;100.00&#34;,&#34;isavailable&#34;:true,&#34;exposure&#34;:[{&#34;name&#34;:&#34;Other&#34;,&#34;value&#34;:&#34;0.0235998&#34;},{&#34;name&#34;:&#34;Treasury / Agency&#34;,&#34;value&#34;:&#34;99.9764002&#34;}],&#34;fundShortName&#34;:&#34;IT Treasury ETF&#34;,&#34;asOfDate&#34;:&#34;09/30/2026&#34;},&#34;styleBox&#34;:{&#34;fixedIncomeStyleBoxAverageWeightedMaturity&#34;:&#34;Intermediate&#34;,&#34;fixedIncomeStyleBoxQuality&#34;:&#34;Government&#34;}}}}'>
