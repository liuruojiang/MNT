onthly updates on estimated realized and unrealized gains in the \"Distributions\" section of the fund’s website page."}}},"0024":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0024/0024","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Explorer_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0022":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0022/0022","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Windsor_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0023":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0023/0023","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_US_Growth_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0828":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0828/0828","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0549":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0549/0549","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0547":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0547/0547","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["4393","4394","4158"],"title":"Vanguard offers additional ESG solutions"}}},"v038":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v038/v038","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0161":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0161/0161","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_SmallCompanyGrowthPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_SmallCompanyGrowthPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0710":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0710/0710","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_ConservativeAllocationPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_ConservativeAllocation_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0277":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0277/0277","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_CapitalGrowthPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_CapitalGrowthPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0278":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0278/0278","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_DiversifiedValueFund.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_DiversifiedValuePortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0551":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0551/0551","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0839":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0839/0839","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0958":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0958/0958","variation":"master","tags":["caas:digital/productdetails"]},"content":{"announcement":{"message":"On March 24, 2026, Vanguard announced that the ETF will complete a 8:1 share split effective April  21, 2026. The share split results in a decrease of the price per share of the ETF with a proportionate increase in the number of shares outstanding. Historical share price data will not be adjusted for the split. Although certain data may reflect both pre- and post-split prices, returns are not impacted."}}},"0838":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0838/0838","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0712":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0712/0712","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_ModerateAllocationPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_ModerateAllocationPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"overviewvideos":{"metadata":{"path":"/content-fragments/caas/digital/product-details/overview-videos/overviewvideos","variation":"master","tags":["caas:digital/productdetails"]},"content":{"videos":[{"cta":"Watch now","description":"Get up close and personal with VCRB's PM as he explains our core bond strategy.","title":"Portfolio manager insights","imageLarge":"/content/dam/fas/visual-asset/media/Arvind_B_DesktopAndMobile.png","posterImageLarge":"/content/dam/fas/visual-asset/media/Arvind_DesktopPlayer.png","url":"https://www.youtube.com/embed/puBcu6abFng?si=iS6It4wSYMtPKdoJ"},{"cta":"Watch now","description":"Get the scoop on our PM’s core-plus bond investing strategy in this 1-minute video.","title":"Hear from the portfolio manager","imageLarge":"/content/dam/fas/visual-asset/media/Dan_B_DesktopAndMobile_129x129.png","posterImageLarge":"/content/dam/fas/visual-asset/media/Dan_DesktopPlayer.png","url":"https://www.youtube.com/embed/4KuNx-rFIyg?si=dRpThez90MkmJ6Zn"},{"cta":"Watch now","transcriptExpanded":"<p class=\"p2\">I think the foundation Stone of our edge comes back to the partnership structure that we have. So for those who are less familiar with Baillie Gifford, we're a Scottish investment firm. We were founded over 100 years ago. We're a private partnership. So as a partner in the firm, our focus is on delivering good client outcomes today and in the future in order to be able to hand over the business to our successor partners in better shape than we received it ourselves.<\/p><p class=\"p2\">I think that that foundational structure gives us the possibility of good long-term returns. But on top of that, we need to add some cultural aspects and behavioral aspects. And I think chief among those, I would emphasize a constant desire to improve, to get better, to challenge ourselves. I would emphasize the diverse nature of our recruitment, the fact that we bring in people from a range of different backgrounds related to the fact related to that, the fact that we seek wisdom from outside the financial world.<\/p><p class=\"p2\">We believe that most insight doesn't come from within the world of finance but comes from experts and academics beyond. We emphasize the role of sustainable investing in a genuine sense. We learn from mistakes rather than criticizing people for making mistakes, the inevitable things that go wrong. And finally, we need, and we've been fortunate to have very supportive clients who understand what we're doing.<\/p><p class=\"p2\">So I think there's a structural aspect to the partnership structure that enables us to be long term. And then there are important behavioral layers that sit on top of that that we need constantly to work out. But if we get those two things right, the structural and the behavioral, we think we're in a good place to continue delivering good returns for our clients over the next five to ten years and beyond.<\/p>","description":"Learn about Thomas Coutts' approach to managing the Vanguard International Growth Fund.","funds":["0081","0581"],"transcriptInitial":"<p class=\"p2\">So our objective as investors is to deliver positive long term returns to clients in excess of those generated by an international equity benchmark. Specifically, we aim to be patient investors in exceptional growth companies on behalf of our clients. And I think all three aspects of that matter the patient ownership, the exceptional growth companies, we're really looking for extreme outliers, a small handful of businesses and the focus on client outcomes. What's our edge in achieving that?<\/p>","title":"Thomas Coutts' summary","imageLarge":"/content/dam/fas/visual-asset/media/TC_B_DesktopAndMobile.png","posterImageLarge":"/content/dam/fas/visual-asset/media/TC_DesktopPlayer.png","url":"https://www.youtube.com/embed/xirnnqN_QIg?si=2JQ4l6aTlETHoPU8"},{"cta":"Watch now","transcriptExpanded":"<p class=\"p2\">And we're trying to create a fund in a portfolio that represents where innovation is happening, how health care is going to be delivered around the world to create great outcomes for the Vanguard owners.  <br><br>The active edge of the Vanguard Health Care Fund is the team. We have many PHDs, MDs that are looking and figuring out where medicine is going. <br><br>That would be number one. I think number two would be sort of the longevity edge. You take both Vanguard, which evaluates us as portfolio managers on a long-term horizon, and you take the ownership model of Wellington who also evaluates us on a long-term horizon. We are able to capture that longevity piece that part of of the market that most people don't operate in.  And then finally, maybe I'll talk a little bit about my own personal edge. So one of the things that I think I do particularly well is connect dots. I love connecting dots over time, connecting dots between small companies and big companies and companies in Japan and companies in Europe and companies in the US to figure out where the health care markets are going.  <br><br>We have a team of 14 global industry analysts that are helping us study the health care industry whether it's biotech or pharmaceutical companies, medical technology companies or health care service companies. And it's the job of our team, this team of 14, to really figure out where medicine is going. How is cancer being treated in 2023 versus where it will be treated in 2030? That's where our team spends our time trying to figure out where the future is going.  And if we can get that right, we're going to do really well.<\/p>","description":"CEO and Managing Partner Jean Hynes discusses the fund’s long-term investment approach and the expert team spotting emerging health care trends and opportunities.","funds":["0552","0052"],"transcriptInitial":"<p class=\"p2\">So I've been associated with the Vanguard Health Care Fund since the beginning of 1993. I was the biotech and pharmaceutical analyst. And that first period of time, was really about learning to be a great researcher. Like, how do you figure out where health care is going? How do I figure out where medicine was going and how to connect those to insights.  I became a co-portfolio manager in 2008, and then I became the team leader and the sole portfolio manager for the fund.  <br><br>We are researching the whole broad spectrum of health care around the world. <\/p>","title":"Investing in the future of health care","imageLarge":"/content/dam/fas/images/digital/portraits/JH_B_DesktopAndMobile.jpg","posterImageLarge":"/content/dam/fas/images/digital/portraits/JH_DesktopPlayer.jpg","url":"https://www.youtube.com/embed/xirnnqN_QIg?si=7YviaOTOt1M"},{"cta":"Watch now","transcriptExpanded":"<p class=\"p2\">It starts with our team. In our active business, we have about 150 portfolio managers, traders and research analysts worldwide, specializing in all publicly traded fixed income sectors. That allows for a depth of expertise across the bond market. Rather than relying on concentrated risk positions, our managers deploy a diversified set of strategies that we believe offers our clients a better chance of investment success. <\/p><p class=\"p2\">Our process thrives on close collaboration and specialized skill.  Portfolio managers marry the macroeconomic trends with perspectives from the sector analysts, creating an optimal approach for each fund. Simultaneously, our analysts and traders actively pursue the best opportunities in the markets they cover. Because our investors are our owners and enables us to pass along economies of scale and lower the cost of investing and our low expense ratios allow us to take a differentiated approach when taking risks. Given our low fees, we have an asymmetric advantage to deliver net out performance to our clients. When the risk reward outlook appears less attractive, for example, when a recession may be on the horizon, we could take a more defensive approach in credit. We don't have to take significant risk through all market environments just to try to deliver outperformance above our fees.  And when the market presents attractive opportunities, our specialized teams are intent on finding the best course to implement across our portfolios.<\/p><p class=\"p2\">Taken together, our active fixed income team process and low fees have enabled Vanguard to deliver strong outcomes for our clients.<\/p>","description":"Learn about our approach to Active Fixed Income with expert Sara Devereux.","funds":["active_fixed_income"],"transcriptInitial":"<p class=\"p2\">Vanguard is well known for our index funds, but here's something you may not know. Vanguard is one of the world's largest active fixed income fund managers. Our 40 years of experience have honed a time-tested trifecta. Our active team, our process and our low fees which enable our differentiated approach to risk taking have delivered strong outcomes for our clients.<\/p>","title":"Approaching active","imageLarge":"/content/dam/fas/visual-asset/media/SD_B_DesktopAndMobile.png","posterImageLarge":"/content/dam/fas/visual-asset/media/SD_DesktopPlayer.png","url":"https://www.youtube.com/embed/HQD6EKF57Us?si=YvA3Kx81O1RRjgAe"}]}},"0053":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0053/0053","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0051":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0051/0051","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0567":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0567/0567","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3365","0567","0517"],"title":"Looking for more strategies that may provide a hedge against inflation?"}}},"0964":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0964/0964","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3369","0936","0991"],"title":"Looking for more international strategies?"}}},"0961":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0961/0961","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0565":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0565/0565","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Equity_Income_ADM.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0049":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0049/0049","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0046":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0046/0046","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0581","0569","0129"],"title":"Looking for more international strategies?"},"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_International_Value_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0288":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0288/0288","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_MidCapIndexPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_Mid-CapIndexPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0287":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0287/0287","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_TotalStockMarketIndexPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_TotalStockMarketIndexPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0969":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0969/0969","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0967":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0967/0967","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3350","3138","3341"],"title":"Vanguard offers additional style based strategies"},"announcement":{"message":"On March 24, 2026, Vanguard announced that the ETF will complete a 6:1 share split effective April  21, 2026. The share split results in a decrease of the price per share of the ETF with a proportionate increase in the number of shares outstanding. Historical share price data will not be adjusted for the split. Although certain data may reflect both pre- and post-split prices, returns are not impacted."}}},"0968":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0968/0968","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0970","3141","3354"],"title":"Looking for exposure to the total market?"}}},"0723":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0723/0723","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0569":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0569/0569","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0581","0046","0129"],"title":"Looking for more international strategies?"}}},"0724":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0724/0724","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0966":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0966/0966","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0581":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0581/0581","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0046","0569","0129"],"title":"Looking for more international strategies?"},"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_International_Growth_ADM.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0065":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0065/0065","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Equity_Income_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0732":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0732/0732","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0733":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0733/0733","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0970":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0970/0970","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0968","3141","3354"],"title":"Looking for exposure to the total market?"}}},"0573":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0573/0573","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Windsor_II_ADM.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0857":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0857/0857","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0615":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0615/0615","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Strategic_Small-Cap_Equity_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0856":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0856/0856","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"V042":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v042/V042","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"v080":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v080/v080","variation":"master","tags":["caas:digital/productdetails"]},"content":{"announcement":{"ctaUrl":"/strategies/fixed-income/bond-ladder-tool/","message":"View this fund in our BondBuilder™ Laddering Tool to customize and test a bond ladder.","ctaLabel":"Build a bond ladder"}}},"v081":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v081/v081","variation":"master","tags":["caas:digital/productdetails"]},"content":{"announcement":{"ctaUrl":"/strategies/fixed-income/bond-ladder-tool/","message":"View this fund in our BondBuilder™ Laddering Tool to customize and test a bond ladder.","ctaLabel":"Build a bond ladder"}}},"0073":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0073/0073","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Windsor_II_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0864":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0864/0864","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0985":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0985/0985","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3145","3146"],"title":"Looking for more corporate bond funds?"}}},"0865":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0865/0865","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0986":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0986/0986","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3358"],"title":"Looking to increase your REIT exposure further?"}}},"0106":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0106/0106","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_BalancedPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_BalancedPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0103":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0103/0103","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"fundmanagementvideos":{"metadata":{"path":"/content-fragments/caas/digital/product-details/fund-management-videos/fundmanagementvideos","variation":"master","tags":["caas:digital/productdetails"]},"content":{"videos":[{"transcriptExpanded":"<p class=\"p2\">One use case of the Core Bond Fund is as a foundational building block within a diversified fixed income portfolio where the investor can complement this fund with allocation to other products that tilt on duration, quality, or regions. We do not rely on directional bets on the market, but instead focus on strategies that can deliver outperformance over time on a consistent basis. Our goal is long-term client outcomes.<\/p>","description":"Understand how Core Bond is designed to be an active foundational building block for client portfolios.","funds":["1520","1320"],"transcriptInitial":"<p class=\"p2\">The Core Bond strategy is designed to give investors exposure to a broadly diversified, predominantly higher quality aspect of the U.S. fixed income market. The fund employs an active approach to investing in the fixed income market. Our objective within the strategy is to provide total returns in excess of the benchmark while also providing moderate levels of current income.<\/p>","title":"Inside the Fund: A Closer Look at Management Strategy","imageLarge":"/content/dam/fas/visual-asset/media/Arvind_ManagerSection.png","posterImageLarge":"/content/dam/fas/visual-asset/media/Arvind_DesktopPlayer.png","url":"https://www.youtube.com/embed/puBcu6abFng?si=TCIOGfR9NLVfovO8"},{"transcriptExpanded":"<p class=\"p2\">I think the foundation Stone of our edge comes back to the partnership structure that we have. So for those who are less familiar with Baillie Gifford, we're a Scottish investment firm. We were founded over 100 years ago. We're a private partnership. So as a partner in the firm, our focus is on delivering good client outcomes today and in the future in order to be able to hand over the business to our successor partners in better shape than we received it ourselves.<\/p><p class=\"p2\">I think that that foundational structure gives us the possibility of good long-term returns. But on top of that, we need to add some cultural aspects and behavioral aspects. And I think chief among those, I would emphasize a constant desire to improve, to get better, to challenge ourselves. I would emphasize the diverse nature of our recruitment, the fact that we bring in people from a range of different backgrounds related to the fact related to that, the fact that we seek wisdom from outside the financial world.<\/p><p class=\"p2\">We believe that most insight doesn't come from within the world of finance but comes from experts and academics beyond. We emphasize the role of sustainable investing in a genuine sense. We learn from mistakes rather than criticizing people for making mistakes, the inevitable things that go wrong. And finally, we need, and we've been fortunate to have very supportive clients who understand what we're doing.<\/p><p class=\"p2\">So I think there's a structural aspect to the partnership structure that enables us to be long term. And then there are important behavioral layers that sit on top of that that we need constantly to work out. But if we get those two things right, the structural and the behavioral, we think we're in a good place to continue delivering good returns for our clients over the next five to ten years and beyond.<\/p>","description":"See what Tom has to say about the long term approach to managing the Baillie Gifford fund. This team takes a bottom-up, stock-driven approach to country allocation, with the objective of selecting stocks that sustain an above-average growth rate and trade","funds":["0081","0581"],"transcriptInitial":"<p class=\"p2\">So our objective as investors is to deliver positive long term returns to clients in excess of those generated by an international equity benchmark. Specifically, we aim to be patient investors in exceptional growth companies on behalf of our clients. And I think all three aspects of that matter the patient ownership, the exceptional growth companies, we're really looking for extreme outliers, a small handful of businesses and the focus on client outcomes. What's our edge in achieving that?<\/p>","title":"Thomas Coutts's summary","imageLarge":"/content/dam/fas/visual-asset/media/Tom_Coutts_L.png","posterImageLarge":"/content/dam/fas/visual-asset/media/Tom_Coutts_poster.png","url":"https://www.youtube.com/embed/xirnnqN_QIg?si=2JQ4l6aTlETHoPU8"},{"transcriptExpanded":"<p class=\"p2\">And we're trying to create a fund in a portfolio that represents where innovation is happening, how health care is going to be delivered around the world to create great outcomes for the Vanguard owners.  <br><br>The active edge of the Vanguard Health Care Fund is the team. We have many PHDs, MDs that are looking and figuring out where medicine is going. <br><br>That would be number one. I think number two would be sort of the longevity edge. You take both Vanguard, which evaluates us as portfolio managers on a long-term horizon, and you take the ownership model of Wellington who also evaluates us on a long-term horizon. We are able to capture that longevity piece that part of of the market that most people don't operate in.  And then finally, maybe I'll talk a little bit about my own personal edge. So one of the things that I think I do particularly well is connect dots. I love connecting dots over time, connecting dots between small companies and big companies and companies in Japan and companies in Europe and companies in the US to figure out where the health care markets are going.  <br><br>We have a team of 14 global industry analysts that are helping us study the health care industry whether it's biotech or pharmaceutical companies, medical technology companies or health care service companies. And it's the job of our team, this team of 14, to really figure out where medicine is going. How is cancer being treated in 2023 versus where it will be treated in 2030? That's where our team spends our time trying to figure out where the future is going.  And if we can get that right, we're going to do really well.<\/p>","description":"Wellington Management Company CEO Jean Hynes describes how the firm's collaborative culture, private ownership model, and global investment resources help set it apart.","funds":["v021","0521","0053","0552","0527","1767","0536","1896","0551","0021","0027","2404","0052","1567","0036","1496","2247","0051","0057","0547","0534"],"transcriptInitial":"<p class=\"p2\">So I've been associated with the Vanguard Health Care Fund since the beginning of 1993. I was the biotech and pharmaceutical analyst. And that first period of time, was really about learning to be a great researcher. Like, how do you figure out where health care is going? How do I figure out where medicine was going and how to connect those to insights.  I became a co-portfolio manager in 2008, and then I became the team leader and the sole portfolio manager for the fund.  <br><br>We are researching the whole broad spectrum of health care around the world. <\/p>","title":"Wellington Management Company","imageLarge":"/content/dam/fas/visual-asset/media/Wellington_480x480.jpg","posterImageLarge":"/content/dam/fas/visual-asset/media/Wellington_480x480.jpg","url":"https://www.youtube.com/embed/3uqV-VCVtqo?si=fJLOmzZoPb2aUQ_I"},{"transcriptExpanded":"<p class=\"p2\">The fund is a great foundational piece for investors fixed income portfolios. It is especially suited for those clients looking to gain exposure to broad segments of fixed income via a single fund.<\/p><p class=\"p2\">The fund is best for investors who are comfortable with larger exposure to low investment grade sectors and that can benefit from outsourcing, sector allocation and market timing decisions to the funds professional managers. Compared to the Core bond fund, the Plus and Core Plus allows us to take additional exposure to high yield and emerging market sectors when the opportunities arrive. This is likely to generate higher returns over time.<\/p><p class=\"p2\">Both from exposure to riskier sectors and from additional selection opportunities, investors looking for more conservative allocation or those looking to pick their own plus sectors may be better off building their portfolios around our Core bond fund instead. The Vanguard Core Plus Bond Fund gives investors access to 1st fund exposure across fixed income sectors in a single fund.<\/p><p class=\"p2\">This broad universe gives our experienced investors opportunities to find value and to outperform the market over the long run.<\/p>","description":"Find out how our active team can give you more for your core by supplementing high-quality fixed income.","funds":["v003","v001"],"transcriptInitial":"<p class=\"p2\">Vanguard Core Plus Bond is an actively managed fund that gives investors broad exposure across fixed income markets. Exposure starts with high quality segments of the US bond market including government, mortgage and corporate bonds, but can be supplemented with below investment grade sectors and debt from other countries including emerging markets.<\/p>","title":"Inside the Fund: A Closer Look at Management Strategy","imageLarge":"/content/dam/fas/visual-asset/media/Dan_DesktopPlayer.png","posterImageLarge":"/content/dam/fas/visual-asset/media/Dan_DesktopPlayer.png","url":"https://www.youtube.com/embed/4KuNx-rFIyg?si=EJEtGVLRDh-d-Zl8"},{"description":"Learn about the ETF’s objective, investment approach, and potential role in a portfolio from David Palmer.","funds":["V055"],"title":"Hear from the portfolio manager","imageLarge":"/content/dam/fas/fas-images/pages/fund-videos/VUSV%20desktop%20thumbnail.png","posterImageLarge":"/content/dam/fas/fas-images/pages/fund-videos/VUSV%20desktop%20thumbnail.png","url":"https://www.youtube.com/embed/OScm0qJ6Tmo?si=YmhDnr-dMIeqbFim"},{"description":"Learn about the ETF’s objective, investment approach, and potential role in a portfolio from Michael Masdea and Brian Barbetta.","funds":["V054"],"title":"Hear from the portfolio managers","imageLarge":"/content/dam/fas/fas-images/pages/fund-videos/VUSG%20desktop%20thumbnail.png","posterImageLarge":"/content/dam/fas/fas-images/pages/fund-videos/VUSG%20desktop%20thumbnail.png","url":"https://www.youtube.com/embed/hyynhN8lROw?si=GgPVdQwFBiohFFKN"}]}},"productdetails":{"metadata":{"path":"/content-fragments/caas/digital/product-details/productdetails","variation":"master","tags":["caas:digital/productdetails"]},"content":{"overview":{"fundMetrics":{"ytdReturnsMpLabel":"YTD Returns (MP)","distributionYieldDefinition":"The fund's current monthly income dividend per share, annualized (by dividing by the number of days in the month and multiplying by 365) as a percentage of the fund's average NAV during the month.","morningstar":{"tenYears":"10 yrs /","howIsItDeterminedText":"The Overall Morningstar Rating&#153; for a fund is derived from a weighted average of the performance figures associated with its 3-, 5- and 10-year (if applicable) Morningstar Rating metrics, which are based on the risk-adjusted returns, as of the date stated.","threeYears":"3 yrs /","howIsItDeterminedHeading":"How is it determined?","morningstarRatingDefinitionHeading":"Morningstar rating","fiveYears":"5 yrs /","outOfFiveStars":"out of 5 stars","viewCompleteDisclosures":"View complete disclosures","morningstarRatingDefinitionText":"Morningstar has awarded this fund {overallRating} stars based on its risk-adjusted performance compared to the {overallNumberOfFunds} within the <i>{categoryName}<\/i> Morningstar category","morningstarRating":"MORNINGSTAR RATING"},"averagePeerExpenseRatioLabel":"Lipper peer average expense ratio","dividendYieldLabel":"Dividend yield","heading":"Fund metrics","categoryRankingsDefinition":"How a fund's total return performs against its peers (as defined by Morningstar Category) over a 1-, 3-, 5-, or 10-year period. Outperformance ranks range from 100 (best) to 1 (worst).","categoryRankings":"Morningstar rankings","categoryRankingsFootnote":"<em>Note that the competitive performance data shown represent past performance, which is not a guarantee of future results, and that all investments are subject to risks. For the most recent Vanguard fund performance, visit our website at <a href=\"https://advisors.vanguard.com/investments/all\">advisors.vanguard.com/investments/all<\/a>. Only funds with a minimum 1-, 3-, 5-, or 10-year history were included in the comparisons. Results will vary for other time periods.<\/em>","productTypeLabel":"Product type","dividendYieldDefinition":"The annual rate of return on a share of stock, determined by dividing the annual dividend by its current share price. In a stock mutual fund, this figure represents the average dividend yield of the stocks held by the fund.","distributionYieldLabel":"Distribution yield","ytdReturnsNavLabel":"YTD Returns (NAV)"},"investmentsApproachHeading":"Investment approach","trading":{"iov":"IOV","etfExchange":"ETF EXCHANGE","iovDefinition":"<p>Intraday Optimized Value (IOV), also known as the Intraday Indicative Value (IIV), is the calculated per-share price of the ETF, which is published every 15 seconds based on the last sale price of each of the underlying securities in the portfolio basket, plus any estimated cash amounts associated with the creation unit.<\/p>","tradingHeading":"Trading","outstandingShares":"OUTSTANDING SHARES"},"oneManagerWith":"1 manager with","managersWithACombined":"managers with a combined","toolLinks":{"portfolioAnalytics":{"ctaUrl":"/investments/portfolio-construction-tools/portfolio-analytics-tool/portfolio-analytics/portfolio-manager","ctaText":"Explore analytics","shortDescription":"Analyze and compare portfolios, Vanguard models, and the performance impact of custom variables.","title":"Portfolio analytics"},"strategicModels":{"ctaUrl":"/portfolio-construction-tools/model-portfolios/","ctaText":"Explore models","shortDescription":"Simplify your process and customize allocation using Vanguard's diversified, low-cost portfolios.","title":"Model portfolios"}},"fundFacts":{"distributionYieldDefinition":"<p>The fund's current monthly income dividend per share, annualized (by dividing by the number of days in the month and multiplying by 365) as a percentage of the fund's average NAV during the month.<\/p>","secYieldReitDefinition":"<p>The Vanguard REIT Index Fund pays quarterly distributions consisting of dividend income, return of capital, and capital gains. However, the tax characteristics of these distributions cannot be determined until after the end of the year since the REITs in which the fund invests do not designate the composition (i.e., dividend income, return of capital, and capital gains) of their payments until the new calendar year.<\/p><p>Since Vanguard cannot know the taxability of the portfolio's distributions during the year, unadjusted and adjusted effective yields are calculated.<\/p><p>The current unadjusted effective yield is <b>{unadjustedYield}<\/b> as of <b>{unadjustedAsofDate}<\/b>, which is based on the full amount of REIT distributions(dividend income, as well as return of capital and capital gain).<\/p><p>The current adjusted effective yield is <b>{adjustedYield}<\/b> as of <b>{adjustedAsofDate}<\/b>. The adjusted yield reflects a reduction in the income included in the yield based on the average return of capital and capital gain distributions received from the fund's REIT investments for the past 2 calendar years. (These percentages are <b>40.94%<\/b> for <b>2016<\/b> and <b>29.91%<\/b> for <b>2015<\/b>.)<\/p><p>Please remember that the yield is calculated monthly like other stock funds and that Vanguard is not quoting a 30-day SEC yield.<\/p>","secYieldWorldBondDefinition":"<p><b>Important information about Vanguard {fundShortName}<\/b><\/p><p>Investors should be mindful in evaluating Vanguard {fundShortName} current SEC yield. This yield, while accurately calculated based on the SEC requirements, does not capture returns resulting from currency hedging. This fund includes bonds that are denominated in local currencies and hedges returns back to the U.S. dollar to minimize currency risk. Currency hedging can have a meaningful impact on total returns over the short term.<\/p>","secYieldGNMADefinition":"<p><b>Important information about Vanguard {fundShortName} Fund<\/b><\/p><p>Investors should be mindful in evaluating Vanguard {fundShortName} Fund's current SEC yield. This yield, while accurately calculated based on the SEC requirements, does not capture returns resulting from currency hedging. This fund includes bonds that are denominated in local currencies and hedges returns back to the U.S. dollar to minimize currency risk. Currency hedging can have a meaningful impact on total returns over the short term.<\/p>","dividendYield":"DIVIDEND YIELD","lipperPeerAverage":"LIPPER PEER AVERAGE","secYieldInflationProtectSecDefinition":"<p><b>Important information about Vanguard Inflation-Protected Securities Fund<\/b><\/p><p>The yield quoted is the real yield, or the yield before adjusting for inflation. The actual yield on the Vanguard Inflation-Protected Securities Fund will be a combination of the real yield and an inflation adjustment. A complete estimate of the fund's yield requires that an estimate of future inflation be added to the real yield. Because inflation fluctuates, it cannot be projected into the future precisely enough to be included in the yield quote. The inflation adjustment is based on changes to the Consumer Price Index and can either be positive or negative, based on the change to the CPI. Investors interested in maintaining the purchasing power of their investment should reinvest their dividend distributions.<\/p>","disclaimers":{"sevenDaySecYieldDisclaimer":"The yield quotation more closely reflects the current earnings of the fund than the total-return quotation."},"fiscalYearEnd":"fiscal year-end","dividendYieldDefinition":"<p>The annual rate of return on a share of stock, determined by dividing the annual dividend by its current share price. In a stock mutual fund, this figure represents the average dividend yield of the stocks held by the fund.<\/p>","netAssetsFor":"NET ASSETS FOR","sevenDay":"7 DAY","thirtyDay":"30 DAY","holdings":"HOLDINGS","productType":"PRODUCT TYPE","ytdReturnsMp":"YTD RETURNS (MP)","secYieldHighYieldCorpDefinition":"Investors should be cautious in evaluating the Vanguard High-Yield Corporate Fund's current yield. This yield, while accurate, includes a risk premium to compensate investors for a potential loss of capital and income. Since the fund invests in lower-grade bonds, it incurs a higher risk of default on its bond holdings than investment-grade bond portfolios.","distributionYield":"DISTRIBUTION YIELD","secYieldDefinition":"<p>A non-money-market fund's SEC yield is based on a formula mandated by the Securities and Exchange Commission (SEC) that calculates a fund's hypothetical annualized income as a percentage of its assets. A security's income, for the purposes of this calculation, is based on the current market yield to maturity (in the case of bonds) or projected dividend yield (for stocks) of the fund's holdings over a trailing 30-day period. This hypothetical income will differ (at times, significantly) from the fund's actual experience; as a result, income distributions from the fund may be higher or lower than implied by the SEC yield.<\/p><p>The SEC yield for a money market fund is calculated by annualizing its daily income distributions for the previous seven days.<\/p>","fundFactsHeading":"Fund facts","totalNetAssetsDefinition":"<p>This represents the total net assets for all share classes of Vanguard's U.S. funds that share the same investment strategy, management, and holdings, but does not include any collective trusts sharing the same investment mandate.<\/p>","totalNetAssets":"TOTAL NET ASSETS","turnoverRate":"TURNOVER RATE","ytdReturns":"YTD RETURNS","designation":"DESIGNATION","secYield":"SEC YIELD","ytdReturnsNav":"YTD RETURNS (NAV)"},"fundCharacteristics":{"fiscalYearEnd":"fiscal year-end","totalNetAssetsDefinition":"This represents the total net assets for all share classes of Vanguard's U.S. funds that share the same investment strategy, management, and holdings, but does not include any collective trusts sharing the same investment mandate.","netAssetsFor":"Net assets for","totalNetAssets":"Total net assets","fundCharacteristics":"Fund characteristics","turnoverRate":"Turnover rate","holdings":"Holdings","designation":"Designation"},"oneHundredPlusYearsOfExperience":"100+ years of management experience","overviewHeading":"Overview","modelportfolio":{"add":"Add","modelcardTitle":"in Vanguard Models","AcrossOur":"across our ","explore":"Explore","andOtherModelSeries":" other model series","modelPortfolioFootnote":"Not all model portfolios are available to all firms. Contact us to verify your firm’s eligibility and approved offerings.","withinOur":"within our","modelcardShortDescription":"contributes to Vanguard Model Portfolios","PATctaText":"Explore Portfolio Analysis","modelPortfolioLabel":"is featured in <strong>Vanguard Model Portfolios<\/strong>. Discover how it may fit into your portfolio construction strategy ","and":"and","PATcardTitle":"in a portfolio","throughOur":"through our ","analyze":"Analyze","PATcardShortDescription":"to a portfolio to compare and analyze with other portfolios and Vanguard models.","discoverHow":"Discover how"},"exploreManagementLinkText":"Explore Management Details","oneYearOfManagementExperience":"1 year of management experience","objective":"Objective","feesAndMinimums":{"feesAndMinimumsHeading":"Fees & minimums","largeTransactionLimit":"LARGE TRANSACTION LIMIT","redemptionFeeDefinition":"<p>A fee charged by some mutual funds when an investor sells shares. A redemption fee differs from a back-end load because the money is paid back into the fund. Many funds charge redemption fees only when shares are bought and then sold within a specific period of time, generally in an effort to discourage market-timing and short-term trading. Some brokers also charge their clients redemption fees for the sale of securities.<\/p>","largeTransactionPolicy":{"ctaUrl":"/investments/ltqt","policyInstructions":"<p class=\"p2\">Vanguard's large transaction policy requires that you notify us before placing orders on your trading platform for large transactions in Vanguard mutual funds. Early notification of large transactions is critical, since a fund manager's investment opportunities can be severely limited when large transactions are not reported on a timely basis. It is important that we provide the fund managers with timely cash-flow information that can enhance fund performance. Generally, the earlier the fund manager knows of a large trade, the broader the market opportunities available.<\/p><p class=\"p2\">A large transaction is a trade that equals or exceeds a dollar amount designated by the portfolio manager. The amount is based on the fund's investment objective and cash position. Because a trade may be disruptive to a fund's operation or performance, the portfolio manager can accept, reject, or delay such a purchase; delay the delivery of redemption proceeds up to seven days; or deliver a redemption in kind. For purchases or redemptions that meet or exceed a transaction limit, you should call Vanguard at 800-669-0498 as early as possible on the day of the trade to ensure successful execution of your order.<\/p>","heading":"Vanguard's large transaction policy","ctaLabel":"View the large transaction limit for all funds"},"fundNumber":"FUND NUMBER","largeTransactionPolicyLabel":"Large transaction policy","purchaseFee":"PURCHASE FEE","none":"None","purchaseFeeDefinition":"<p>A fee charged by some mutual funds when an investor buys shares. This fee is not a sales charge or load because it is paid directly to the fund to offset the costs of trading certain securities.<\/p>","minimumInvestment":"MINIMUM INVESTMENT","redemptionFee":"REDEMPTION FEE"},"fundManagementLinkText":"Learn more","glidePathMessage":"*Target date is the year stated in the fund name and assumes retirement at age 65.","customInvestmentObjective":{"Fund_0931":"Vanguard Ultra-Short Bond ETF seeks to provide current income while maintaining limited price volatility."},"overviewVideo":{"videoExcludedFunds":["0028","0568","0036","0536","0029","0529"]},"fundManagementHeading":"Management","glidePathHeading":"Glide path","yearsOfManagementExperience":"years of management experience","morningStar":{"tenYears":"10 yrs /","howIsItDeterminedText":"The Overall Morningstar Rating&#153; for a fund is derived from a weighted average of the performance figures associated with its 3-, 5- and 10-year (if applicable) Morningstar Rating metrics, which are based on the risk-adjusted returns, as of the date stated.","threeYears":"3 yrs /","howIsItDeterminedHeading":"How is it determined?","morningstarRatingDefinitionHeading":"Morningstar rating","fiveYears":"5 yrs /","outOfFiveStars":"out of 5 stars","viewCompleteDisclosures":"View complete disclosures","morningstarRatingDefinitionText":"Morningstar has awarded this fund {overallRating} stars based on its risk-adjusted performance compared to the {overallNumberOfFunds} within the <i>{categoryName}<\/i> Morningstar category","morningstarRating":"MORNINGSTAR RATING"}},"literature":{"factSheet":"Fact sheet","subadvisorInsightsLiteratureDescription":"Quarterly performance and portfolio manager commentary from each of the fund's sub-advisors.","fundLitDescriptionAfterCTA":" to subscribe to automatically receive documents.","subscribeToFund":"Subscribe to fund","fundLitDescriptionBeforeCTA":"Download fund literature or visit our ","baillieGiffordReports":{"methodologyReportLabel":"Impact Report: Impact Measurement Methodology","methodologyReportUrl":"https://www.bailliegifford.com/en/usa/non-professional-investor/literature-library/funds/mutual-funds/baillie-gifford-positive-change-equities-impact-measurement-methodology/"},"lockMessage":"You must register or sign in to access this PDF","fundLiteratureHeading":"Literature","contactPopUp":{"heading":"Order Literature","leftDetails":"M-F 8:30 a.m. to 7 p.m., <span class='no-wrap'>Eastern time<\/span>","rightEmail":"advisor_services@vanguard.com","description":"Contact one of our representatives to order print copies of our literature.","leftPhone":"800-997-2798"},"orderFundLiterature":"Order fund literature","fundLitDescriptionCTALabel":"subscriptions center","literatureUnavailableErrorMessage":"Literature could not be retrieved at this time. Please try again later."},"disclaimers":{"morningstar":"<div>&#169; 2021 Morningstar, Inc. All Rights Reserved. The information contained herein: (1) is proprietary to Morningstar; (2) may not be copied or distributed; and (3) is not warranted to be accurate, complete or timely. Neither Morningstar nor its content providers are responsible for any damages or losses arising from any use of this information. Past performance is no guarantee of future results.<\/div><div>The Morningstar Rating<sup>TM<\/sup> for funds, or \"star rating,\" is calculated for managed products (including mutual funds, variable annuity and variable life subaccounts, exchange-traded funds, closed-end funds, and separate accounts) with at least a 3-year history. Exchange-traded funds and open-ended mutual funds are considered a single population for comparative purposes. It is calculated based on a Morningstar Risk-Adjusted Return measure that accounts for variation in a managed product's monthly excess performance, placing more emphasis on downward variations and rewarding consistent performance. The Morningstar Rating does not include any adjustment for sales loads. The top 10% of products in each product category receive 5 stars, the next 22.5% receive 4 stars, the next 35% receive 3 stars, the next 22.5% receive 2 stars, and the bottom 10% receive 1 star. The Overall Morningstar Rating for a managed product is derived from a weighted average of the performance figures associated with its 3-, 5-, and 10-year (if applicable) Morningstar Rating metrics. The weights are: 100% 3-year rating for 36&#8211;59 months of total returns, 60% 5-year rating/40% 3-year rating for 60&#8211;119 months of total returns, and 50% 10-year rating/30% 5-year rating/20% 3-year rating for 120 or more months of total returns. While the 10-year overall star rating formula seems to give the most weight to the 10-year period, the most recent 3-year period actually has the greatest impact because it is included in all three rating periods.<\/div>","moreInformation":"For more information about Vanguard funds and Vanguard ETF Shares, visit advisors.vanguard.com or call 800-997-2798 to obtain a prospectus or, if available, a summary prospectus. Investment objectives, risks, charges, expenses, and other important information about a fund are contained in the prospectus; read and consider it carefully before investing.","reuters":"Market data (\"Data\") is provided by FactSet Research Systems Inc. and its affiliates (\"FactSet\"). The Data is provided \"as is\" and \"as available,\" without warranties of any kind, either express or implied, including without limitation warranties of merchantability, fitness for a particular purpose, accuracy, or timeliness. The Data is provided for informational purposes only and is not intended for trading. To the fullest extent permissible by law, FactSet and its suppliers shall not be liable for use of the Data under any circumstances, including without limitation due to negligence by FactSet.","etf":"<p><i>Vanguard ETF Shares are not redeemable with the issuing Fund other than in very large aggregations worth millions of dollars. Instead, investors must buy and sell Vanguard ETF Shares in the secondary market and hold those shares in a brokerage account. In doing so, the investor may incur brokerage commissions and may pay more than net asset value when buying and receive less than net asset value when selling.<\/i><\/p>","copyrightForExport":"(c) 1995-{currentCopyrightYear} The Vanguard Group, Inc. All rights reserved. Vanguard Marketing Corporation, Distributor.","investorOwned":"Vanguard is investor-owned, meaning the fund shareholders own the funds, which in turn own Vanguard.","mmf1":"<p class=\"p2\"><strong> You could lose money by investing in the Fund. Although the Fund seeks to preserve the value of your investment at $1.00 per share, it cannot guarantee it will do so. An investment in the Fund is not a bank account and is not insured or guaranteed by the Federal Deposit Insurance Corporation or any other government agency. The Fund’s sponsor is not required to reimburse the Fund for losses, and you should not expect that the sponsor will provide financial support to the Fund at any time, including during periods of market stress.<\/strong><\/p>","trf":"<p><I>Investments in Target Retirement Funds are subject to the risks of their underlying funds. The year in the Fund name refers to the approximate year (the target date) when an investor in the Fund would retire and leave the work force. The Fund will gradually shift its emphasis from more aggressive investments to more conservative ones based on its target date. An investment in the Target Retirement Fund is not guaranteed at any time, including on or after the target date.<\/I><\/p>"},"fundVoting":{"fundVotingHeading":"Proxy voting"},"performance":{"performanceHeading":"Performance","totalReturns":{"summary":{"summary":"Summary","quarterEndPreTax":"Quarter-end (pre-tax)","averageAnnual":"AVERAGE ANNUAL","recentReturns":"RECENT RETURNS","quarterEndAfterTax":"Quarter-end (after-tax)","returnAfterTaxesOnDistributions":"Return after taxes on distributions and sale of fund shares","benchmarkVarianceDefinition":"<p>The difference in a fund's non-fee adjusted return versus an identified benchmark or peer group.<\/p>","returnAfterTaxes":"Return after taxes on distributions","moreInfo":"More information on after-tax returns","afterTaxMoreInfoForm":"<p class='p1'>After-tax returns are calculated using the highest individual federal income tax rates in effect at the time of each distribution. They do not reflect the impact of state and local taxes.<\/p><h3>You should know that:<\/h3><ul><li>Your after-tax return depends on your individual tax situation and may differ from the figures presented here.<\/li><li>If you own fund shares in a tax-deferred account, such as an IRA or 401(k) plan, this information does not apply to your investment because these accounts are not subject to current taxes.<\/li><li>The fund's past performance, whether before or after taxes, does not indicate how it will perform in the future.<\/li><li>If a fund incurs a loss, which generates a tax benefit, the post-liquidation after-tax return may exceed the fund's other return figures.<\/li><li>After-tax returns are quarter-end adjusted for fees and loads if applicable.<\/li><li>After-tax returns for VanguardÂ® funds reflect the reduced tax rates on ordinary income, qualified dividend income, and short-term and long-term capital gains that went into effect in 2003.<\/li><li>After-tax returns for non-Vanguard funds are provided by Morningstar, Inc., based on data provided by the funds. Recent changes in tax law may cause after-tax returns to be calculated inconsistently across different fund families. Accordingly, after-tax returns for mutual fund peer groups have been temporarily removed.<\/li><li>For Vanguard Tax-Managed Balanced Fund and Vanguard REIT Index Fund, conservative estimates are used based on fund history until final amounts become available.<\/li><\/ul>","plusMinusBenchmark":"+/- Benchmark"},"common":{"monthEnd":"Month-end","oneYear":"1 YEAR","differenceFairValueDefinition":"<p>In order to determine the performance of the fund prior to adjustments for fair value pricing, simply subtract the <b>Difference due to fair value pricing<\/b> figure from the <b>NAV performance<\/b> figure. For example, by subtracting -0.09% from 18.23%, we arrive at a performance figure of 18.32% [18.23% - (-0.09%) = 18.32%]<\/p>","fiveYear":"5 YEAR","year":"YEAR","navETF":"(NAV)","tenYear":"10 YEAR","threeYear":"3 YEAR","differenceFairValue":"Difference due to fair value pricing","marketPriceETF":"(Market price)","quarterEnd":"Quarter-end"},"totalReturnsHeading":"Total returns","cumulative":{"oneMonth":"1 MONTH","threeMonth":"3 MONTH","cumulative":"Cumulative"},"quarterly":{"firstQuarter":"1ST QUARTER","noQuarterlyDataAvailable":"This fund does not have a long enough history to provide quarterly performance data.","thirdQuarter":"3RD QUARTER","incomeReturnByNAV":"Income return by NAV","yearEndReturn":"YEAR-END RETURN","fourthQuarter":"4TH QUARTER","quarterly":"Quarterly","secondQuarter":"2ND QUARTER"},"annually":{"noAnnualDataAvailable":"This fund does not have a long enough history to provide annual performance data.","totalReturnByNAV":"Total return by NAV","totalReturnByMarketPrice":"Total return by market price","capitalReturnByNAV":"Capital return by NAV","annually":"Annually"}},"avengers":{"link":"View previous data","text":"A previous share class for this fund referred to as \"investor shares\" were closed to investors on November 7, 2019."},"exportReturnsData":"Export returns data","footnotes":{"mutualFundFeeAdjustedFootnote":"Note: Fee adjusted for mutual funds where applicable.","noHistoryToAnnual":"Note: This fund does not have a long enough history to provide annual performance data.","noHistoryToCurrentYear":"Note: This fund does not have a long enough history to provide current year performance data.","sinceInceptionFootnote":"Since inception","ytdBenchmarkFootnote":"Year-to-date performance data is not available for the benchmark.","noHistoryToQuarterly":"Note: This fund does not have a long enough history to provide quarterly performance data."}},"common":{"performs":"performs ","compare":"Compare","cusip":"CUSIP","marketPrice":"MARKET PRICE","compareWithFundsYouViewed":"Compare with funds you viewed","asOf":"as of","yearToDate":"YTD","accessibility":{"opensPdf":"Opens a PDF","opensWindow":"Opens a new window","download":"Download","downloadsCsv":"Downloads a CSV file","opensLayer":"Opens a layer"},"seeHow":"See how ","operationalExpenseRatio":"Operational expense ratio","plusMorePeerFunds":"Plus more peer funds","disclaimers":{"performance":"<p><i>The performance data shown represent past performance, which is not a guarantee of future results. Investment returns and principal value will fluctuate, so investors' shares, when sold, may be worth more or less than their original cost. Current performance may be lower or higher than the performance data cited.<\/i><\/p>","attributionDisclaimer":"The portfolio attribution data shown above is provided by FactSet based on information provided by Vanguard about the fund's daily portfolio holdings as of the market close. Because the fund buys and sells stocks throughout the trading day and not necessarily at the market close, the attribution data shown above is an estimate, and may not precisely reflect actual attribution information. Information noted above does not reflect fair value adjustments to prices of foreign securities held in the portfolio.","performanceDisclaimer":"<p><i>The performance of an index is not an exact representation of any particular investment, as you cannot invest directly in an index. Benchmark comparative indexes represent unmanaged or average returns on various financial assets, which can be compared with funds' total returns for the purpose of measuring relative performance.<\/i><\/p>","feeDisclaimer":"<p><i>Performance data for periods of less than one year do not reflect the deduction of purchase and redemption fees. Maintenance, low-balance, and service fees may be assessed by some funds. None of these fees are reflected in the performance figures. If these fees were included, the performance would be lower. All other performance data are adjusted for purchase and redemption fees, where applicable.<\/i><\/p>"},"videoCookieMessage":{"ctaText":"here","initial":"<div>You have certain cookies disabled on the Vanguard site.<\/div><div>In order to watch this video, you must agree to the use of cookies provided by YouTube.<\/div><div>Click","backgroundImage":"/content/dam/fas/fas-images/patterns/axs-graphic-pattern-2-yellow-dark-sq.svg","after":"to permit these cookies and watch the video.<\/div>"},"inceptionDate":"INCEPTION DATE","analyzePerformanceFeesAndMore":"Analyze performance, fees, and more","acquiredFundFeesAndExpenses":"Acquired fund fees and expenses","viewdetailedcomparison":"View detailed comparison","nav":"NAV","compareWithPeerFunds":"Compare with peer funds","sinceInception":"Since inception","benchmark":"Benchmark","notApplicable":"N/A","expenseRatio":"Expense ratio","navDefinition":"For funds with a fluctuating price per share, the net asset value (NAV) is the market value of a mutual fund's total assets, minus liabilities, divided by the number of shares outstanding. The value of a single share is called its share value or share price.<br><br>For money market funds that seek to maintain a stable price per share, the NAV is calculated by valuing securities at amortized cost, which approximates market value.","to":"to","secYield":{"secYieldInflationProtectSecDefinition":"<p><b>Important information about Vanguard Inflation-Protected Securities Fund<\/b><\/p><p>The yield quoted is the real yield, or the yield before adjusting for inflation. The actual yield on the Vanguard Inflation-Protected Securities Fund will be a combination of the real yield and an inflation adjustment. A complete estimate of the fund's yield requires that an estimate of future inflation be added to the real yield. Because inflation fluctuates, it cannot be projected into the future precisely enough to be included in the yield quote. The inflation adjustment is based on changes to the Consumer Price Index and can either be positive or negative, based on the change to the CPI. Investors interested in maintaining the purchasing power of their investment should reinvest their dividend distributions.<\/p>","secYieldReitDefinition":"<p>The Vanguard REIT Index Fund pays quarterly distributions consisting of dividend income, return of capital, and capital gains. However, the tax characteristics of these distributions cannot be determined until after the end of the year since the REITs in which the fund invests do not designate the composition (i.e., dividend income, return of capital, and capital gains) of their payments until the new calendar year.<\/p><p>Since Vanguard cannot know the taxability of the portfolio's distributions during the year, unadjusted and adjusted effective yields are calculated.<\/p><p>The current unadjusted effective yield is <b>{unadjustedYield}<\/b> as of <b>{unadjustedAsofDate}<\/b>, which is based on the full amount of REIT distributions(dividend income, as well as return of capital and capital gain).<\/p><p>The current adjusted effective yield is <b>{adjustedYield}<\/b> as of <b>{adjustedAsofDate}<\/b>. The adjusted yield reflects a reduction in the income included in the yield based on the average return of capital and capital gain distributions received from the fund's REIT investments for the past 2 calendar years. (These percentages are <b>40.94%<\/b> for <b>2016<\/b> and <b>29.91%<\/b> for <b>2015<\/b>.)<\/p><p>Please remember that the yield is calculated monthly like other stock funds and that Vanguard is not quoting a 30-day SEC yield.<\/p>","secYieldHighYieldCorpDefinition":"<p>Investors should be cautious in evaluating the Vanguard High-Yield Corporate Fund's current yield. This yield, while accurate, includes a risk premium to compensate investors for a potential loss of capital and income. Since the fund invests in lower-grade bonds, it incurs a higher risk of default on its bond holdings than investment-grade bond portfolios.<\/p>","sevenDay":"7 day","sevenDaySecYieldDisclaimer":"The yield quotation more closely reflects the current earnings of the fund than the total-return quotation.","secYieldDefinition":"<p>A non-money-market fund's SEC yield is based on a formula mandated by the Securities and Exchange Commission (SEC) that calculates a fund's hypothetical annualized income as a percentage of its assets. A security's income, for the purposes of this calculation, is based on the current market yield to maturity (in the case of bonds) or projected dividend yield (for stocks) of the fund's holdings over a trailing 30-day period. This hypothetical income will differ (at times, significantly) from the fund's actual experience; as a result, income distributions from the fund may be higher or lower than implied by the SEC yield.<\/p><br><p>The SEC yield for a money market fund is calculated by annualizing its daily income distributions for the previous seven days.<\/p>","secYieldWorldBondDefinition":"<p><b>Important information about Vanguard {fundShortName}<\/b><\/p><p>Investors should be mindful in evaluating Vanguard {fundShortName} current SEC yield. This yield, while accurately calculated based on the SEC requirements, does not capture returns resulting from currency hedging. This fund includes bonds that are denominated in local currencies and hedges returns back to the U.S. dollar to minimize currency risk. Currency hedging can have a meaningful impact on total returns over the short term.<\/p>","thirtyDay":"30 day","secYieldGNMADefinition":"<p><b>Important information about Vanguard {fundShortName} Fund<\/b><\/p><p>Investors should be mindful in evaluating Vanguard {fundShortName} Fund's current SEC yield. This yield, while accurately calculated based on the SEC requirements, does not capture returns resulting from currency hedging. This fund includes bonds that are denominated in local currencies and hedges returns back to the U.S. dollar to minimize currency risk. Currency hedging can have a meaningful impact on total returns over the short term.<\/p>","secYield":"SEC yield"}},"portfolio":{"fundamentals":{"fundamentals":"Fundamentals","averageMaturityTooltip":"<b>Average maturity (money market funds only)<\/b><\/br>Average maturity represents the weighted average maturity of the fund's holdings using the date of the next interest rate adjustment for certain adjustable-rate securities held by the fund.","numberOfBonds":"Number of bonds","yieldToMaturityTooltip":"The rate of return an investor would receive if a security is held to its maturity date.","alternativeMinimumTax":"Alternative minimum tax","percentOfADRs":"% of ADRs","optionAdjustedSpread":"Option adjusted spread","fundamental":"Fundamental","optionAdjustedSpreadTooltip":"The Option Adjusted Spread of a security is quoted in basis points. It is the average spread of a security over its entire respective curve after factoring out the embedded option value.","percentEmerging":"% Emerging","averageEffectiveMaturity":"Average effective maturity","long":"Long","taxEquivalentYield":"Tax-equivalent yield","peRatio":"P/E ratio","weightedAverageLife":"Weighted average life","averageCoupon":"Average coupon","pbRatio":"P/B ratio","averageMaturity":"Average maturity","percentDeveloped":"% Developed","medianMarketCapDefinition":"An indicator of the size of companies in which a fund invests the midpoint of market capitalization (market price x shares outstanding) of a funds stocks, weighted by the proportion of a fund's assets invested in each stock.  Stocks representing half of the fund's assets have market capitalizations above the median and the rest are below it.","yieldToMaturity":"Yield to maturity","earningsGrowthRate":"Earnings growth rate","peRatioDefinition":"A weighted harmonic average of the P/E Ratios of all the equity securities held within the fund or benchmark, using the last 12 months of earnings expressed as a percentage of the month-end closing price. Companies with negative earnings are excluded.","conversionPremium":"Conversion premium","numberOfSecurities":"Number of securities","foreignHoldings":"Foreign holdings","averageEffectiveMaturityTooltip":"Average Effective Maturity is defined as the average length of time until fixed income securities held by a fund are expected to be repaid, taking into consideration that an action such as a call or refunding may cause some bonds to be repaid before they mature.","averageDuration":"Average duration","yieldToWorstTooltip":"Lowest yield possible for a security given the current price, taking into account both call dates and maturity. ","shortTermReserves":"Short-term reserves","yieldToWorst":"Yield to worst","averageStatedMaturity":"Average stated maturity","turnoverRate":"Turnover rate","returnOnEquity":"Return on equity","short":"Short","medianMarketCap":"Median market cap","numberOfHoldings":"Number of holdings","numberOfStocks":"Number of stocks"},"compareProducts":{"compareProducts":"Compare products","compareProductsText":"Perform direct, side-by-side product comparisons of up to five Vanguard and non-Vanguard products with our relatable, unbiased product comparison tool."},"portfolioHeading":"Portfolio","marketCapitalization":{"mediumLarge":"Medium/Large","small":"Small","large":"Large","mediumCapitalization":"Medium capitalization","marketSize":"MARKET SIZE","medium":"Medium","mediumLargeCapitalization":"Medium/Large capitalization","long":"LONG","mediumSmallCapitalization":"Medium/Small capitalization","moreInformation":{"internationalLarge":"$18,290 billion and above","internationalMedium":"$5,611 billion to $14,318 billion","aboutMarketCap":"More information about market capitalization","domesticMediumLarge":"$73,447 billion to $89,224 billion","description":"Market capitalization boundaries are defined by Vanguard and are effective until December 31, 2025.","domesticMedium":"$24,248 billion to $73,447 billion","domesticLarge":"$89,224 billion and above","internationalMediumLarge":"$14,318 billion to $18,290 billion","internationalSmall":"$2.968 billion and below","domestic":"U.S.","internationalMediumSmall":"$2.968 billion to $5,611 billion","domesticMediumSmall":"$11,146 to $24,248 billion","international":"International","domesticSmall":"$11,146 billion and below"},"largeCapitalization":"Large capitalization","marketCapitalizationHeading":"Market capitalization","plusMinusWeight":"+/- WEIGHT","smallCapitalization":"Small capitalization","short":"SHORT","mediumSmall":"Medium/Small"},"topHoldings":{"ticker":"Ticker","percentagesMayNotAdd":"Percentages may not add up to 100%.","cusipFootnote":"CUSIP identifiers have been provided by CUSIP Global Services, managed on behalf of the American Bankers Association by Standard & Poor's Financial Services, LLC, and are not for use or dissemination in a manner that would serve as a substitute for any CUSIP service. The CUSIP Database, &copy; 2011 American Bankers Association. 'CUSIP' is a registered trademark of the American Bankers Association.","moneyMarketFundFootnote":"Go to the {sec_website} to obtain the most recent 12 months of publicly available information filed by the fund with the SEC on Form N-MFP.","commodities":"Commodities","commodityFundHoldingDetails":{"customSwapLinkUrl":"/assets/corp/fund_communications/pdf_publish/us-products/VCMDXcustomswap.pdf","customSwapLinkText":"View the most recent custom swap holding details.","customSwapHoldingsHeading":"Custom swap holdings"},"portfolioHoldingsInformation":"Portfolio holdings information","sedol":"SEDOL","equity":"Equity","exportFullHoldings":"Export full holdings","deviationsFootnote":"* There may be deviations when applying fair value and other considerations.","faceAmount":"Face amount","holding":{"thisFundHasNoDerivativesHoldings":"This fund has no derivatives holdings","notionalCommodityExposureBreakdown":"Notional commodity exposure breakdown","notionalMarketValue":"Notional Market Value","holdingsNotEnoughHistoryError":"This fund does not have a long enough history to provide holdings data.","description":"Description","sharesAndContracts":"Shares/Contracts","strategyType":"Strategy Type","holdingsPolicyForThisFund":"Holdings policy for this fund","shares":"Shares","thisFundHasNoShortTermReserveHoldings":"This fund has no short-term reserve holdings.","maturityDate":"Maturity date","thisFundHasNoFixedIncomeHoldings":"This fund has no fixed income holdings.","topHoldingsPolicy":"<h3>Vanguard portfolio holdings disclaimer<\/h3><h2>Disclosing portfolio holdings<\/h2><p class=\"p2\">Vanguard may publish on this site, in the fund's <strong>Portfolio<\/strong> details, the 10 largest stock portfolio holdings of a Vanguard fund&#8212;including the percentage of the fund's total assets that each of these holdings represents&#8212;as of the most recent calendar-quarter-end. This information will generally be published 15 calendar days after the end of the calendar quarter (except for Vanguard index funds, which will generally be published 15 calendar days after the end of the month).<\/p><p class=\"p2\">Vanguard may also publish on this site, in the fund's <strong>Portfolio<\/strong> details, the 10 largest stock portfolio holdings of a Vanguard fund&#8212;including the aggregate percentage that these holdings represent of the fund's total net assets&#8212;as of the most recent month-end. This information will generally be published 10 business days after the end of the month.<\/p><p class=\"p2\">Vanguard may also publish on this site, in the fund's <strong>Portfolio<\/strong> details, a detailed list of the securities held in certain actively managed Vanguard ETFs and certain Vanguard index ETFs (portfolio holdings) on a daily basis.<\/p><p class=\"p2\">Vanguard may also publish on this site, in the fund's <strong>Portfolio<\/strong> details, a detailed list of the securities (aggregated by issuer for money market funds) held in a Vanguard fund (portfolio holdings) as of the most recent calendar-quarter-end. This information would be published 30 days after the end of the calendar quarter, except for:<\/p><ul><li>Vanguard Market Neutral Fund, for which information would be published 60 calendar days after the end of the calendar quarter.<\/li><li>Vanguard index funds (except for certain Vanguard index ETFs) and Vanguard actively managed fixed income funds, for which information would be published 15 calendar days after the end of the month.<\/li><li>Vanguard money market funds, for which information would be published within 5 business days after the last business day of the preceding month.<\/li><\/ul><p class=\"p2\">Except with respect to Vanguard money market funds:<\/p><ul><li>Vanguard may exclude any portion of these portfolio holdings from publication on this site when deemed in the best interest of the fund.<\/li><li>The portfolio holdings are provided on a delayed basis and won't necessarily represent all of the actual investments held by the relevant Vanguard fund.<\/li><\/ul><p class=\"p2\">Portfolio holdings may exclude any temporary cash investments and equity index products.<\/p><h2>Terms & conditions<\/h2><p class=\"p2\">The following additional terms and conditions apply to the publication on this site of any Vanguard fund's portfolio holdings as described above:<\/p><ul><li>By accessing the portfolio holdings, you agree not to reproduce, distribute, or disseminate the portfolio holdings, in whole or in part, in any form without prior written permission from Vanguard.<\/li><li>Except with respect to Vanguard money market funds, the portfolio holdings are provided on an \"as is\" basis. Vanguard makes no express or implied warranties or representations with respect to the accuracy, completeness, reliability, or fitness of the portfolio holdings or any financial results you may achieve from their use.<\/li><li>In no event shall Vanguard or its affiliates have any liability relating to the use of the portfolio holdings.<\/li><\/ul>","holdings":"HOLDINGS","fairValue":"Fair Value","thisFundHasNoCurrencyHoldings":"This fund has no currency holdings.","thisFundHasNoUnderlyingFundHoldings":"This fund has no derivatives holdings.","notionalValue":"Notional value","swap":"Swap P/L","showFewerHoldings":"Show fewer holdings","marketValue":"MARKET VALUE","notionalMarketValuePercentage":"Notional Value Percentage","thisFundHasNoCommodityHoldings":"Nothing to display.","percentOfFunds":"% OF FUNDS","accept":"Accept","holdingsTermsAndConditions":"<h3>Exhibit B<br />Visitor Legal Terms<\/h3><p class=\"p2\">Please read and indicate your acceptance of these additional terms by clicking on the link at the bottom of the page. You are about to enter into an agreement with CUSIP Global Services. If you do not agree with these terms, then please do not click I Accept. By clicking <b>I Accept<\/b>, you agree to accept and be bound by the terms and conditions of this agreement.<\/p><p class=\"p2\">The CUSIP data contained in www.vanguard.com, www.personal.vanguard.com, www.advisors.vanguard.com, and www.institutional.vanguard.com (the Vanguard Web Site) consists of security identifiers and related descriptive information (the CUSIP database) and is protected under the U.S. copyright laws and is licensed with permission from CUSIP Global Services (CGS), on behalf of the American Bankers Association (ABA).<\/p><p class=\"p2\">Visitor agrees and acknowledges that the CUSIP database and the information contained therein is and shall remain valuable intellectual property owned by, or licensed to, CUSIP Global Services and the American Bankers Association (ABA), and that no proprietary rights are being transferred to Visitor in such materials or in any of the information contained therein. Any use of the CUSIP data by Visitor outside of the clearing and settlement of transactions requires a license from CGS, along with an associated fee based on usage. Visitor agrees that misappropriation or misuse of such materials will cause serious damage to CGS and ABA, and that in such event money damages may not constitute sufficient compensation to CGS and ABA; consequently, Visitor agrees that in the event of any misappropriation or misuse, CGS and ABA shall have the right to obtain injunctive relief in addition to any other legal or financial remedies to which CGS and ABA may be entitled.<\/p><p class=\"p2\">Visitor agrees that it shall not publish nor distribute in any medium the CUSIP database or any substantial portion of the information contained therein or summaries or subsets thereof to any person or entity. Visitor may not create or maintain a master file or database of CUSIP identifiers or descriptions for itself or any third party recipient that is intended to serve as a substitute for any CUSIP service.<\/p><p class=\"p2\">Visitor agrees not to:<\/p><ol><li>Violate the restrictions in any robot inclusion headers on the Vanguard Web Site or in any way bypass or circumvent any other measure employed to limit or prevent access to the CUSIP data on the Vanguard Web Site;<\/li><li>Violate the security of the Vanguard Web Site or attempt to gain unauthorized access to the Web Site, CUSIP data, materials, information, computer systems or networks connected to Vanguard server, through hacking, password mining or any other means; or<\/li><li>(3)Interfere or attempt to interfere with the proper working of the Vanguard Web Site or any activities conducted on or through the Vanguard Web Site.<\/li><\/ol><p class=\"p2\">NEITHER CGS, ABA NOR ANY OF THEIR AFFILIATES MAKE ANY WARRANTIES, EXPRESS OR IMPLIED, AS TO THE ACCURACY, ADEQUACY OR COMPLETENESS OF ANY OF THE INFORMATION CONTAINED IN THE CUSIP DATABASE. ALL SUCH MATERIALS ARE PROVIDED TO VISITOR ON AN 'AS IS' BASIS, WITHOUT ANY WARRANTIES AS TO MERCHANTABILITY OR FITNESS FOR A PARTICULAR PURPOSE OR USE NOR WITH RESPECT TO THE RESULTS WHICH MAY BE OBTAINED FROM THE USE OF SUCH MATERIALS. NEITHER CGS, ABA NOR THEIR AFFILIATES SHALL HAVE ANY RESPONSIBILITY OR LIABILITY FOR ANY ERRORS OR OMISSIONS NOR SHALL THEY BE LIABLE FOR ANY DAMAGES, WHETHER DIRECT OR INDIRECT, SPECIAL OR CONSEQUENTIAL, EVEN IF THEY HAVE BEEN ADVISED OF THE POSSIBILITY OF SUCH DAMAGES. IN NO EVENT SHALL THE LIABILITY OF, CGS, ABA OR ANY OF THEIR AFFILIATES PURSUANT TO ANY CAUSE OF ACTION, WHETHER IN CONTRACT, TORT, OR OTHERWISE, EXCEED THE FEE PAID BY VISITOR FOR ACCESS TO SUCH MATERIALS IN THE MONTH IN WHICH SUCH CAUSE OF ACTION IS ALLEGED TO HAVE ARISEN. FURTHERMORE, CGS AND ABA SHALL HAVE NO RESPONSIBILITY OR LIABILITY FOR DELAYS OR FAILURES DUE TO CIRCUMSTANCES BEYOND THEIR CONTROL.<\/p><p class=\"p2\">Visitor agrees that the foregoing terms and conditions shall survive any termination of its right of access to the materials identified above.<\/p>","showAllHoldings":"Show all holdings","hashOfContracts":"# OF CONTRACTS","holdingsMessage":"The fund's holdings contain CUSIP numbers, which are subject to certain terms and conditions. To access the holdings, please {view_terms_conditions} and accept these terms and conditions.","thisFundHasNoStockHoldings":"This fund has no stock holdings."},"derivatives":"Derivatives","couponYield":"Coupon","shortTermReserves":"Short-term reserves","topHoldingsHeading":"Holdings details","exhibitB":"Exhibit B","currency":"Currencies","fixedIncome":"Fixed income","sector":"SUB-INDUSTRY","effectiveDate":"Effective Date","strDataTableMM":{"titleOfIssuer":"Title of issuer","amortizedCost":"Amortized cost","effectiveMaturity":"Effective maturity","nameOfIssuer":"Name of issuer","categoryOfInvestment":"Category of investment","principalAmount":"Principal amount","finalMaturity":"Final maturity"}},"holdingSearch":{"validationMessages":{"noSpecialCharacters":"Special characters are not allowed."},"searchByName":"Search holdings by name","searchByNameTickerOrSector":"Search holdings by name, ticker, or sub-industry.","searchOnSmall":"Search holdings","searchByNameOrTicker":"Search holdings by name or ticker","error":{"beforeSearchInput":"There are no results for ","afterSearchInput":". Try adjusting your search."}},"stylebox":{"styleboxDescription":"<p>The stylebox gives information about a fund's investment style in visual form.<\/p><p>The stylebox labels are considered objectives and are aspirational in nature and do not reflect a historical depiction of the fund's holdings.<\/p><p>For equity funds, a stylebox's rows and columns indicate market capitalization (small, mid, large) and investment style (value, blend, growth); for fixed income funds, its rows and columns indicate credit quality and/or duration (short, medium, long).<\/p><p>Two important things about a fund are shown in its stylebox:<\/p><p><strong>Central tendency.<\/strong> The fund's central tendency reflects the aggregate characteristics resulting from the fund's approach to security selection. Because it is based on an analysis of the performance characteristics of the fund's potential holdings over long periods, the central tendency is expected to be relatively stable. In the stylebox, it is shown as a dot within the shaded oval.<\/p><p><strong>Expected range.<\/strong> Within the fund's universe of potential holdings, and depending on the fund's investment approach, some categories of investments will be owned more frequently; together, they are known as the expected range. In the stylebox, the expected range of frequently owned categories is represented by a shaded oval.<\/p><p><strong>Note:<\/strong> Styleboxes for fixed income funds use duration rather than average weighted maturity. Duration is a more accurate measure of interest rate sensitivity because it takes into consideration all mortgage prepayments, puts, and adjustable coupons.<\/p>","styleboxHeading":"Stylebox","fixedIncome":"Fixed income","moreInfo":"How to read our stylebox","equity":"Equity"},"allocationOfUnderlyingFunds":{"investorTRFFunds":{"fund_0304":"2025","fund_0699":"2050","fund_0306":"2045","fund_0305":"2035","fund_0308":"Income","fund_1691":"2060","fund_1791":"2065","fund_0682":"2020","fund_0696":"2040","fund_0695":"2030","fund_1487":"2055","fund_V009":"2070"},"allocationToUnderlyingETFsHeading":"Allocation to underlying ETFs","institutionalTRFFunds":{"fund_1668":"2040","fund_1667":"2035","fund_1669":"2045","fund_1671":"2055","fund_1792":"2065","fund_1670":"2050","fund_1673":"Income","fund_1672":"2060","fund_1664":"2020","fund_1663":"2015","fund_1666":"2030","fund_1665":"2025"},"allocationToUnderlyingFundsHeading":"Allocation to underlying funds","fund":"Fund","percentOfFund":"% of fund","allocationToUnderlyingFunds":"Allocation to underlying funds","rank":"Rank","fundName":"Fund name","cash":"Cash","hyperLinkDisabledFunds":["Commodities","Vanguard Morgan Growth Fund Investor Shares"],"incomeFund":"Income"},"liquidityAssets":{"date":"Date","dailyLiquidAssets":"Daily liquid assets","liquidityAssetsHeading":"Liquidity assets","weeklyLiquidAssets":"Weekly liquid assets","weeklyLiquidAssetsHover":"<p><b>Weekly liquid assets<\/b> generally consist of government securities, cash, and assets that will mature in <b>five<\/b> business days.<\/p>","dailyLiquidAssetsHover":"<p><b>Daily liquid assets<\/b> generally consist of government securities, cash, and assets that will mature in <b>one<\/b> business day.<\/p>","dailyNetShareholderCashFlowHover":"<p><b>Daily net shareholder cash flow<\/b> is the net dollar amount of all shareholder inflows and outflows for the reported date. It is calculated by subtracting shares redeemed from shares purchased.<\/p>","dailyNetShareholderCashFlow":"Daily net shareholder cash flow","exportLiquidityData":"Export liquidity data"},"weightedExposures":{"country":"COUNTRY","commoditySectorBreakdown":"Commodity Sector Breakdown","regions":"Regions","statedMaturityTooltip":"<strong>Distribution by stated maturity (municipal bond funds and Tax-Managed Balanced)<\/strong><br/>Represents the percentage of fund assets in each maturity category. Stated Maturity methodology is used to determine the maturity category each holding is allocated to. Stated maturity is defined as the stated maturity date for each fixed income security held by the fund.","distributionByEffectiveMaturity":"Distribution by effective maturity","subindustry":"Subindustry","issuer":"Issuer","concentrationByState":"Concentration by state","weightedExposuresHeading":"Weighted exposures","plusMinusWeight":"+/- WEIGHT","issuerType":"Issuer type","sector":"Sector","creditRating":"Credit rating","sectors":"Sectors","maturity":"Maturity","percentOfFund":"% of fund","distributionByCreditQuality":"Distribution by credit quality","subsectors":"Subsectors","distributionByCoupon":"Distribution by coupon","compositionDisclosure":"Weighted equity exposures exclude any temporary cash investments and equity index futures. Some short-term fixed income securities are classified as cash and are excluded from the weighted bond exposures.","distributionByStatedMaturity":"Distribution by stated maturity","exportButton":{"tab_distribution_by_maturity":"Export maturity data","tab_markets":"Export market data","tab_sectors":"Export sector data","tab_regions":"Export regions data","tab_state":"Export state data","tab_issuer_type":"Export issuer type data","tab_distribution_by_coupon":"Export distribution by coupon data","tab_allocation":"Export allocation of underlying funds data","tab_subsectors":"Export subsector data","tab_distribution_by_credit_quality":"Export credit quality data"},"markets":"Markets","couponYield":"Coupon","effectiveMaturityTooltip":"<strong>Distribution by effective maturity (taxable bond funds and balanced funds except Tax-Managed Balanced)<\/strong><br/>Represents the percentage of fund assets in each maturity category. Effective maturity methodology is used to determine the maturity category each holding is allocated to. Effective maturity is defined as the length of time until a fixed income security held by a fund reaches maturity and is repaid, taking into consideration that an action such as a call or refunding may cause some bonds to be repaid before they mature.","region":"REGION"},"state":"State","assetAllocation":{"assetAllocationHeading":"Asset allocation","assetClass":"ASSET CLASS"},"footnotes":{"averageDurationFootnote":"The duration estimates the fund's percentage change in price for a given change in the real interest rates in the TIPS market. Historically, the real interest rates on TIPS have been somewhat less volatile than the nominal yields of conventional US Treasury bonds. However, the relationship varies over time and is difficult to predict. There may be periods when TIPS real yields and prices are more volatile than conventional Treasury bonds.","yieldToMaturityFootnote":"This figure is an estimated yield to maturity (YTM) for the fund. It is calculated by adding the trailing 12-month inflation adjustment to the 'real' (i.e., before inflation) YTM of the fund. Adding the 12-month inflation adjustment allows the fund's yield to be more directly comparable with those of other bond funds","allocationOfUnderlyingOthersFootnote":"The fund may invest in selected other investments that have historically generated capital appreciation over the long term while exhibiting low correlation with the returns of the U.S. stock market."},"portfolioCompositionFile":{"pcfTicker":"Ticker","downloadCompositionFile":"Export composition file","pcfTermsDescription":"By accessing the Portfolio Composition File (PCF), you agree not to reproduce, distribute, or disseminate the PCF, in whole or in part, in any form without prior written permission of The Vanguard Group, Inc. (Vanguard) and Morgan Stanley Capital International (MSCI). All information in the PCF is provided on an \"as is\" basis, and Vanguard and MSCI make no express or implied warranties or representations of any kind with respect to any of the information contained in the PCF (including, without limitation, with respect to the accuracy, completeness, reliability, merchantability, or fitness for a particular purpose of any such information or any financial results you may achieve from its use). In no event shall Vanguard, MSCI, or their affiliates have any liability relating to the use of the PCF. The PCF is provided on a delayed basis and does not necessarily represent the holdings of the relevant Vanguard&#174; fund, either on the date it was originally published or currently. You may use the PCF solely in connection with evaluating purchases and sales of ETF Shares. This information is for informational purposes only and may not be used in connection with any other financial product or index.","pcfDescription":"Description","pcfTermsHeading":"Terms and conditions for Portfolio Composition Files","pcfDefinition":"The Portfolio Composition File identifies the expected name and amount of each security that \"authorized participants\" were required to deposit/receive with Vanguard to purchase/redeem a Creation Unit of ETF Shares on that date. Except in certain circumstances as deemed appropriate by Vanguard in accordance with applicable internal policies and regulatory requirements, an authorized participant purchasing/redeeming ETF Shares on that date would deposit/receive the same securities in the same amounts as shown on the PCF.","pcfAccept":"Accept","pcfAsOf":"Portfolio composition as of","portfolioCompositionFileHeading":"Portfolio Composition File","pcfAcceptTermsDescription":"Accept to view and export composition file.","pcfShares":"Shares","pcfReviewTerms":"Review terms & conditions"}},"errorPage":{"returnHome":"Return home","pageNotFound":"Page not found","pageUnavailable":"Page unavailable","pageNotFoundDescription":"The page you’re looking for may no longer exist. Try a search or return to the homepage.","pageUnavailableDescription":"We're sorry, but it looks like there's a problem with our server. This is usually a temporary issue, and we're working to fix it as quickly as possible. Please try again later."},"price":{"historicalPrices":{"date":"DATE","oneMonth":"1 month","sinceInception":"Since inception","volumeTens":"Volume","twelveMonth":"12 months","volume":"VOLUME","volumeThousands":"Volume (thousands)","disclaimers":{"copyright":"&#169;2021 The Vanguard Group, Inc. All rights reserved. Vanguard Marketing Corporation, Distributor.","moreInformation":"**For more information on Vanguard funds or ETFs, visit advisors.vanguard.com or call 800-997-2798 to obtain a prospectus or, if available, a summary prospectus. Investment objectives, risks, charges, expenses, and other important information about a fund are contained in the prospectus; read and consider it carefully before investing.**","performance":"**The performance data shown represent past performance, which is not a guarantee of future results. Investment returns and principal value will fluctuate, so investors' shares, when sold, may be worth more or less than their original cost. Current performance may be lower or higher than the performance data cited.**","vanguardEtfShares":"**Vanguard ETF Shares are not redeemable with the issuing Fund other than in very large aggregations worth millions of dollars. Instead, investors must buy and sell Vanguard ETF Shares in the secondary market and hold those shares in a brokerage account. In doing so, the investor may incur brokerage commissions and may pay more than net asset value when buying and receive less than net asset value when selling.**","patents":"U.S. Patent No. 6,879,964."},"current":"Current","high":"HIGH","sixMonth":"6 months","exportHistoricalPrices":"Export historical price data","fiveYear":"5 year","low":"LOW","price":"Price","name":"NAME","threeMonth":"3 months","historicalPricesHeading":"Historical prices","fiveDay":"5 day","eighteenMonth":"18 months","open":"OPEN","volumeHundreds":"Volume (hundreds)","volumeMillions":"Volume (millions)"},"priceDistributionHeading":"Price & distributions","realizedUnrealizedGains":{"percentChange":"% of NAV","unrealizedGain":"UNREALIZED GAINS OF NAV","realizedGain":"REALIZED GAIN","realizedUnrealizedGainsHeading":"Realized/Unrealized gains","distributionSchedule":"DISTRIBUTION SCHEDULE"},"premiumDiscountChart":{"date":"DATE","premiumDiscount":"PREMIUM/DISCOUNT","exportPremiumPrices":"Export premium prices","splitLabel":"Share split","greatestDiscount":"GREATEST DISCOUNT","greatestPremium":"GREATEST PREMIUM","understandingPremiumDiscountDescription":"Premium and discount information is calculated to illustrate the historical differences between an ETF's market price and the value of its underlying securities, or its NAV. Because ETFs are traded throughout the day on a stock exchange, their prices may at times vary from the value of their underlying securities&mdash;trading at a premium with significant buying demand and at a discount with selling demand. This disconnect is typically corrected through an ETF's unique creation and redemption process. In the case of a premium, an Authorized Participant would create shares of an ETF by buying the underlying securities, delivering them to the fund provider in exchange for ETF shares, which would, in turn, be sold until the premium has eroded. As a result, price differences tend to be fleeting.","numberOfDaysAtPremium":"# OF DAYS AT PREMIUM","price":"Price","greatestPremiumDate":"GREATEST PREMIUM DATE","numberOfDaysAtDiscount":"# OF DAYS AT DISCOUNT","greatestDiscountDate":"GREATEST DISCOUNT DATE","q1":"Q1","q2":"Q2","splitDisclaimer":"* This fund had a share split occurring on {splitDate}.","disclosure":"For more information on Vanguard funds, visit www.vanguard.com, or call 800-662-7447, to obtain a prospectus. Visit our website, call 866-499-8473, or contact your broker to obtain a prospectus for Vanguard ETF&reg; Shares. Investment objectives, risks, charges, expenses, and other important information are contained in the prospectus; read and consider it carefully before investing.","q3":"Q3","currentQuarter":"Current qtr","q4":"Q4","understandingPremiumDiscountHeading":"Understanding premium/discount","premiumDiscountChartHeading":"Premium/Discount chart","percentOfDaysWithin":"% OF DAYS WITHIN 0.25%","summaryFor":"Summary for","numberOfDaysWithin":"# OF DAYS WITHIN 0.25%","premiumDiscountPercent":"Premium/Discount (%)"},"currentAndClosingPrice":{"premiumDiscount":"PREMIUM/DISCOUNT","closingPriceHeading":"Closing price","factsetDisclaimer":"Quotes are provided by ","bidAskSpread":"BID/ASK SPREAD","down":"DOWN","high":"HIGH","low":"LOW","sevenDay":"7 DAY","reutersDisclaimer":"Quotes delayed at least 20 minutes. Source: FactSet financial data and analytics","thirtyDay":"30 DAY","up":"UP","currentPriceHeading":"Current price","fiftyTwoWeekHigh":"52-WEEK HIGH","factsetDisclaimerEnd":"and are for informational purposes only. They may be delayed, inaccurate, incomplete, or unavailable.","dailyChange":"DAILY CHANGE","bidAskSpreadLinkUrl":"/investments/bidaskspread","navChange":"NAV CHANGE","marketPriceChange":"MARKET PRICE CHANGE","tick":"TICK","twentyFiveDayAvgVolume":"25-DAY AVG VOLUME","bidAskSpreadLinkText":"View the median bid/ask spreads for all Vanguard ETFs","closingPriceAsOfDate":"Closing price as of","fiftyTwoWeekLow":"52-WEEK LOW","volume":"VOLUME","size":"SIZE","currentPriceAsOf":"Current price as of","factsetLabel":"FactSet","thirtyDayBidAskSpreadMedian":"30-DAY MEDIAN BID/ASK SPREAD","fiftyDayAvgVolume":"50-DAY AVG VOLUME","fiftyTwoWeekDifference":"52-WEEK DIFFERENCE","open":"OPEN","legalStatement":"Legal statement"},"distribution":{"distributionYieldDefinition":"<p>The fund's current monthly income (excluding capital gains distributions) dividend per share, divided by the days since the last distribution and multiplied by 365, and shown as a percentage of the fund's average net asset value over that period.<\/p>","tenYearsMessage":"Use this table to view or export up to ten years of distributions for this fund.<br><br>You can view the <a href=\"https://advisors.vanguard.com/tax-center/year-end-distributions\">2025 year-end capital gains<\/a> for all funds in the Tax Center.","distributionHeading":"Distribution","distributionYieldAsOf":"DISTRIBUTION YIELD AS OF","inflationProtected":{"heading":"Important information about {fundLongName} distributions","body1":"Income from the {fundLongName} is from 2 sources: real yield and an inflation adjustment that maintains the purchasing power of investments over time. Investors interested in maintaining the purchasing power of their investments should reinvest their dividend distributions.","body2":"Because inflation fluctuates, it cannot be projected into the future with any accuracy. Measured over short periods, inflation can deviate from its long-term trend. A complete estimate of the fund's total distributions requires that an estimate of future inflation be added to the real yield. The inflation adjustment can be positive or negative, based on the change in the Consumer Price Index."},"distributionNotEnoughHistoryError":"This fund does not have a long enough history to provide distribution data.","reinvestDate":"REINVEST DATE","distribution":"Distribution","type":"TYPE","reinvestPriceDefinition":"<p>The price at which an investment's dividend or capital gains distribution is reinvested, if requested by the shareholder, to purchase additional shares.<\/p>","exportDistributionData":"Export distribution data","payableDateDefinition":"<p>The date when dividends or capital gains are paid to shareholders. For Vanguard mutual funds, the payable date is usually within two to four days of the record date. The payable date also refers to the date on which a declared stock dividend or bond interest payment is scheduled to be paid.<\/p>","recordDate":"RECORD DATE","exDividendDateDefinition":"<p>The date when a distribution of dividends and/or capital gains is deducted from the share price of a mutual fund or stock, and the security begins trading without the distribution. On the ex-dividend date, the share price drops by the amount of the distribution (plus or minus any market activity).<\/p>","excelFormattingNote":"Note: Microsoft Excel opens the downloaded file with $/share column in currency format rounded to two decimal places. To show all five (5) decimal places adjust the decimal place position or change the format of the column to general.","distributionYield":"DISTRIBUTION YIELD","exDividendDate":"EX-DIVIDEND DATE","dollarsPerShare":"$/SHARE","reinvestPrice":"REINVEST PRICE","footnote":"For more information about Vanguard funds and Vanguard ETF Shares, visit advisors.vanguard.com or call 800-997-2798 to obtain a prospectus or, if available, a summary prospectus. Investment objectives, risks, charges, expenses, and other important information about a fund are contained in the prospectus; read and consider it carefully before investing.","couponLinkLabel":"Coupon interest and inflation adjustment","payableDate":"PAYABLE DATE","recordDateDefinition":"<p>The date established by the issuer of a security for the purpose of determining the holders who are entitled to receive that security's next distribution of dividends or capital gains.<\/p>","footnotes":{"highYieldFootnote":"Investors should be cautious in evaluating the Vanguard High-Yield Corporate Fund's current yield. This yield, while accurate, includes a risk premium to compensate investors for a potential loss of capital and income. Since the fund invests in lower-grade bonds, it incurs a higher risk of default on its bond holdings than investment-grade bond portfolios.","inflationProtectedFootnote":"Investors should be cautious in evaluating the current yield of the Vanguard Inflation-Protected Securities Fund. This yield, while accurate, includes a risk premium to compensate investors for a potential loss of capital and income. Since the fund invests in lower-grade bonds, it incurs a higher risk of default on its bond holdings than investment-grade bond portfolios."},"reinvestDateDefinition":"<p>The date on which an investment's dividend or capital gains income is reinvested, if requested by the shareholder, to purchase additional shares.<\/p>"}},"hero":{"generalLabel":"General","factSheet":"Fact sheet","compare":"Compare","threeYearStandardDeviation":"3 YR Standard Deviation","availableIn":"Also available as","relatedShareClasses":{"mutualFundClassesHeading":"Mutual fund share classes","etfSharesText":"Exchange-traded shares of certain Vanguard mutual funds. ETF Shares combine the benefits of indexing (low costs and broad-market diversification) with the trading and pricing flexibility of individual stocks.","ticker":"TICKER","investorSharesHeading":"Investor Shares","institutionalPlusSharesText":"Shares generally available to institutions or other investors with fund account balances from $100 million to $200 million, depending on the fund.","etfFundClassesHeading":"ETF fund classes","shareClass":"SHARE CLASS","institutionalSharesHeading":"Institutional Shares","admiralSharesHeading":"Admiral&trade; Shares","institutionalSelectSharesText":"Shares generally available to large institutional investors. Fund account minimums range from $3 billion to $5 billion, depending on fund.","institutionalPlusSharesHeading":"Institutional Plus Shares","institutionalSelectSharesHeading":"Institutional Select Shares","investorSharesText":"Traditional shares for individual investors that typically feature low minimum initial investments.","admiralSharesText":"A share class with lower expense ratios than those for Investor Shares and no minimum investment requirements.","shareClassOptionsText":"Vanguard offers multiple share classes (depending on the fund). A fund's investment objective, management, and underlying investments are identical in each class. The expense ratios distinguish the share classes and reflect the differing costs of each share class.","inceptionDate":"INCEPTION DATE","etfSharesHeading":"ETF Shares","shareClassOptionsHeading":"Vanguard share-class options","institutionalSharesText":"Shares for companies and organizations with account balances of $5 million or more.","aboutShareClassesHeading":"About share classes","minimum":"MINIMUM"},"navChange":"NAV CHANGE","surveyLabel":"Is this the key fund data?","fundClosedToAllMessage":"Closed to all investors.","marketPriceChange":"MARKET PRICE CHANGE","oneYearStandardDeviation":"1 YR Standard Deviation","additionalShareClasses":"Also available in","prospectus":"Prospectus","bidAskSpread":"30 day Bid/Ask Spread","moreShareClasses":"more share classes","compareFund":"Compare product","oneYearReturnsNav":"1 YR Returns (NAV)","newFund":"New Fund","fundClosedToNewMessage":"Closed to new investors.","specialFundClosedMessage":"Available only as an underlying investment in Vanguard funds of funds or similar products.","contactSales":{},"summaryProspectus":"Summary prospectus","factSheetSubscription":{"preSubscribePromptHeader":"Get this fund's fact sheet when it becomes available at the end of this quarter.","subscriptionErrorHeader":"We hit a technical snag","subscriptionLoadIndicator":"Subscribing...","subscriptionErrorDescription":{"beforeLinkText":"Try searching for this fund in ","ctaUrl":"/subscriptions/preferences/fund-literature","afterLinkText":" to add literature manually.","ctaLabel":"subscriptions"},"certificationLayerHeader":"Enter subscription information","subscriptionConfirmationDescription":"Close this layer to download the fact sheet.","preSubscribeConfirmationDescription":"You'll receive this fact sheet once it's available.","noThanksLabel":"No, just download","subscriptionConfirmationHeader":"Subscribed!","opensNewLayer":"Opens new layer","closesLayer":"Closes layer","subscriptionPromptHeader":"Would you like us to send this fund's fact sheet to you each quarter?","preSubscribeLabel":"Subscribe","subscribeLabel":"Yes, subscribe and download"}},"risk":{"trackingError":"Tracking error","riskHeading":"Risk","trackingErrorDefinition":"<p>Tracking error is the divergence between the return of the fund and the return of the associated benchmark.<\/p>","earliestInceptionDate":"Risk and volatility are based on the share class with the earliest inception date.","standardDeviationDefinition":"<p>A measure of the degree to which a fund's return varies from its previous returns or from the average of all similar funds. The larger the standard deviation, the greater the likelihood (and risk) that a security's performance will fluctuate from the average return.<\/p>","alphaDefinition":"<p>A measure of performance on a risk-adjusted basis. Alpha takes the volatility (price risk) of a mutual fund and compares its risk-adjusted performance to a benchmark index. The excess return of the fund relative to the return of the benchmark index is a fund's alpha.<\/p>","captureRatioDefinition":"The downside/upside capture ratio shown here represents whether the given fund has outperformed&#8212;lost less or gained more than&#8212;the primary prospectus benchmark during periods of market weakness and strength, and if so, by how much.<br><br>Upside capture ratios for funds are calculated by taking the fund's monthly return during months when the benchmark had a positive return and dividing it by the benchmark return during that same month. Downside capture ratios are calculated by taking the fund's monthly return during the periods of negative benchmark performance and dividing it by the benchmark return. Morningstar.com displays the upside and downside capture ratios over 1-, 3-, 5-, 10-, and 15-year periods by calculating the geometric average for both the fund and index returns during the up and down months, respectively, over each time period.<br><br>An upside capture ratio over 100 indicates a fund has generally outperformed the benchmark during periods of positive returns for the benchmark. Meanwhile, a downside capture ratio of less than 100 indicates that a fund has lost less than its benchmark in periods when the benchmark has been in the red. However, if a fund generates positive returns while the benchmark declines, the fund's downside capture ratio will be negative (meaning it has moved in the opposite direction of the benchmark). All stock funds' upside and downside capture ratios are calculated versus the S&P 500, whereas bond and international fund ratios are calculated relative to the Barclays Capital U.S. Aggregate Bond Index and MSCI EAFE Index, respectively. For some context, we also show the category average upside/downside capture ratios for those same time periods.","rSquared":"R-squared","sharpeRatioDefinition":"<p>A measure of risk-adjusted return. To calculate a Sharpe ratio, an asset's excess returns (its return in excess of the return generated by risk-free assets such as Treasury bills) is divided by the asset's standard deviation.<\/p>","broadBasedBenchmark":"Broad-based benchmark","threeYear":"3 year","riskAndVolatilityHeading":"Risk and volatility","primaryBenchmark":"Primary benchmark","fiveYear":"5 year","rSquaredDefinition":"<p>A measure of how much of a portfolio's performance can be explained by the returns from the overall market (or a benchmark index). If a portfolio's total return precisely matched that of the overall market or benchmark, its R-squared would be 1.00. If a portfolio's return bore no relationship to the market's returns, its R-squared would be 0. <\/p>","alpha":"Alpha","youngFundMessage":"Risk and volatility information is not available for a strategy less than 3 years old.","betaDefinition":"<p>A measure of how much of a portfolio's performance can be explained by the returns from the overall market (or a benchmark index). If a portfolio's total return precisely matched that of the overall market or benchmark, its beta would be 1.00. If a portfolio's return bore no relationship to the market's returns, its beta would be 0. <\/p>","thirtySixMonthMessage":"Risk measures are calculated from trailing 3, 5, and 10 year fund returns relative to the associated benchmarks.","sharpeRatio":"Sharpe ratio","captureRatio":"Capture ratio (downside/upside)","beta":"Beta","standardDeviation":"Standard deviation","tenYear":"10 year"},"fundManagement":{"activeFixedIncomeFootnote":"Note: Vanguard calculations, based on data from Morningstar, Inc., as of December 31, 2021, show that Vanguard active fixed income funds had an average asset-weighted expense ratio of 10.4 basis points, compared with an average asset-weighted expense ratio of 49.0 basis points for non-Vanguard active fixed income funds.","quarterlyCommentaryHeading":"Quarterly commentary","fundManagementHeading":"Management","lessThanOneYearFund":"<1 year on fund","yearsExperience":"years of experience","yearsOnFund":"years on fund","oneYearExperience":"year of experience","oneYearFund":"year on fund","lessThanOneYearExperience":"<1 year of experience"}}},"0223":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0223/0223","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0868":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0868/0868","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0109":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0109/0109","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_GrowthPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_GrowthPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0869":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0869/0869","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0866":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0866/0866","variation":"master","tags":["c