nications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_International_Explorer_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0122":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0122/0122","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0927":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0927/0927","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0924","0925","3148"],"title":"Looking for bond building blocks?"}}},"0807":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0807/0807","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0928":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0928/0928","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3711","4391","3061"],"title":"Vanguard offers additional broad bond exposure"}}},"0925":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0925/0925","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0924","0927","3148"],"title":"Looking for bond building blocks?"}}},"0923":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0923/0923","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0920","4415","4430"],"title":"Looking for other dividend focused strategies"}}},"0924":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0924/0924","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0925","0927","3148"],"title":"Looking for bond building blocks?"}}},"0129":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0129/0129","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["0581","0046","0569"],"title":"Looking for more international strategies?"},"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Global_Equity_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"v013":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v013/v013","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/funds/reports/bi102.pdf","litTypeCode":"SR"}]}},"0260":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0260/0260","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_HighYieldBondFund.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_HighYieldBondPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"v014":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/v014/v014","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"085":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-085/085","variation":"master","tags":["caas:digital/productdetails"]},"content":{"announcement":{"ctaUrl":"/insights/article/discover-how-our-expense-ratio-reductions-are-creating-lasting-impact-for-your-clients","message":"We just lowered expense ratios for 84 share classes across 53 funds and ETFs, including this one!","ctaLabel":"Learn more"}}},"v012":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v012/v012","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/funds/reports/bi102.pdf","litTypeCode":"SR"}]}},"v010":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-v010/v010","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/funds/reports/bi101.pdf","litTypeCode":"IP"}]}},"0931":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0931/0931","variation":"master","tags":["caas:digital/productdetails"]},"content":{"investmentObjective":"Vanguard Ultra-Short Bond ETF seeks to provide current income while maintaining limited price volatility.","investmentProcess":"<p class='p1'>Vanguard Ultra-Short Bond ETF seeks to provide current income while maintaining limited price volatility, and aggregate performance consistent with ultra-short-term, investment-grade fixed income securities. It is expected to maintain a dollar-weighted average maturity of 0 to 2 years. Under normal circumstances, the fund will invest at least 80% of its assets in fixed income securities. Vanguard Fixed Income Group, the fund's advisor, emphasizes sectors and securities that represent good relative value, while modestly adjusting portfolio duration to reflect the near-term interest rate outlook, shape of the yield curve, and other factors. With a 0.10% expense ratio&#8212;a fourth of the asset-weighted active industry average&#8212;your client's money may go further.<\/p>"}},"0257":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0257/0257","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/content/dam/fas/pdfs/VVIF_TotalBondMarketIndexPortfolio.pdf","asOfDate":"09/30/2025","title":"Third quarter holdings","litTypeCode":"QHLD"},{"pdfPath":"/content/dam/fas/pdfs/VVIF_TotalBondMarketIndexPortfolio_1Q.pdf","asOfDate":"03/31/2026","title":"First quarter holdings","litTypeCode":"QHLD"}]}},"0530":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0530/0530","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0135":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0135/0135","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0938":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0938/0938","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0939":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0939/0939","variation":"master","tags":["caas:digital/productdetails"]},"content":{"announcement":{"message":"On March 24, 2026, Vanguard announced that the ETF will complete a 4:1 share split effective April  21, 2026. The share split results in a decrease of the price per share of the ETF with a proportionate increase in the number of shares outstanding. Historical share price data will not be adjusted for the split. Although certain data may reflect both pre- and post-split prices, returns are not impacted."}}},"0936":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0936/0936","variation":"master","tags":["caas:digital/productdetails"]},"content":{"relatedFunds":{"funds":["3369","0964","0991"],"title":"Looking for more international strategies?"}}},"0937":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0937/0937","variation":"master","tags":["caas:digital/productdetails"]},"content":{}},"0934":{"metadata":{"path":"/content-fragments/caas/digital/product-details/custom-fund-content/fund-0934/0934","variation":"master","tags":["caas:digital/productdetails"]},"content":{"literature":[{"pdfPath":"/assets/corp/fund_communications/pdf_publish/us-products/advisor-insights/Subadvisor_Insights_Selected_Value_INV.pdf","asOfDate":"06/30/2026","litTypeCode":"SI"}]}},"0935":{"me