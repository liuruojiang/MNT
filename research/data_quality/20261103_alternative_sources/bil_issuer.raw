    <script>
    function updateCookieConsent(){
        const elements = document.querySelectorAll(".ssmp-cookie-consent");
        for(let element of elements){
            const categoryStr = element.dataset.cookieCategories;
            if(!categoryStr){
                continue;
            }

            const categories = categoryStr.split(",");
            if(!categories || categories.length <= 0){
                continue;
            }
            
            let notMatched = false;
            for(let ctg of categories){
                if(typeof OptanonActiveGroups === "undefined" || !OptanonActiveGroups.includes("," + ctg + ",")){
                    notMatched = true;
                    break;
                }
            }

            if(notMatched){
                element.dataset.cookieConsent = "false";
            }else {
                element.dataset.cookieConsent = "true";
            }
        }
    }
    function OptanonWrapper() {
        if(typeof removeRootCookieConsent === "function"){
            removeRootCookieConsent();
        }

        updateCookieConsent();
    }

    document.addEventListener('DOMContentLoaded', function(){
        updateCookieConsent();
    });
    </script>
    <!-- OneTrust Cookies Consent Notice end for ssga.com -->



    
    
