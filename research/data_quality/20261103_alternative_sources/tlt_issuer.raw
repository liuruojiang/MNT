&quot;visible&quot;:true,&quot;label&quot;:&quot;Closing Price&quot;,&quot;formattedValue&quot;:&quot;81.84&quot;,&quot;sortOrder&quot;:171,&quot;prefix&quot;:&quot;$&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;closingPrice&quot;},&quot;consolidatedVolume&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Daily Volume&quot;,&quot;formattedValue&quot;:&quot;41,115,720.00&quot;,&quot;sortOrder&quot;:177,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The number of shares traded in a security across all U.S. exchanges on the date indicated.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;consolidatedVolume&quot;},&quot;cusip&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;CUSIP&quot;,&quot;formattedValue&quot;:&quot;464287432&quot;,&quot;sortOrder&quot;:121,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;cusip&quot;},&quot;distributionFrequency&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Distribution Frequency&quot;,&quot;formattedValue&quot;:&quot;Monthly&quot;,&quot;sortOrder&quot;:72,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;How often a distribution is paid by the fund. The most common distribution frequencies are annually, biannually and quarterly.&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;distributionFrequency&quot;},&quot;exchange&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Exchange&quot;,&quot;formattedValue&quot;:&quot;NASDAQ&quot;,&quot;sortOrder&quot;:13,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;exchange&quot;},&quot;indexSeriesName&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Benchmark Index&quot;,&quot;formattedValue&quot;:&quot;ICE US Treasury 20+ Year Bond Index&quot;,&quot;sortOrder&quot;:34,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;On 12/1/2023 TLT began to track the standard pricing variant of the ICE US Treasury 20+ Year Bond Index, which now utilizes 4pm as its pricing time (previously it was 3pm) and resulted in a discontinuation of the 4pm pricing variant. Historical index data from 3/1/2021 to 11/30/2023 is for the 4pm pricing variant of the ICE US Treasury 20+ Year Index. Historical index data from 4/1/2016 through 2/28/2021 is for the 3pm pricing variant of the ICE US Treasury 20+ Year Index. In order to facilitate the transition from the 3pm pricing variant to the 4pm pricing variant, historical index data for 3/1/2021 includes an additional hour of performance from 3-4pm on 2/26/2021, which accounts for 135 basis points of performance, as calculated by the index provider. A basis point is one hundredth of one percent. Historical index data prior to 4/1/2016 is for the Bloomberg U.S. 20+ Year Treasury Bond Index.&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;indexSeriesName&quot;},&quot;indexTicker&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Bloomberg Index Ticker&quot;,&quot;formattedValue&quot;:&quot;IDCOT20&quot;,&quot;sortOrder&quot;:36,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;indexTicker&quot;},&quot;investmentStyle&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Investment Style&quot;,&quot;formattedValue&quot;:&quot;Index&quot;,&quot;sortOrder&quot;:37,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Active Funds do not seek to replicate the performance of a specified index and the management team has discretion to manage the Fund’s portfolio in accordance with the Fund’s investment objectives. Index Funds seek to track the investment results of their underlying index.&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;investmentStyle&quot;},&quot;launchDate&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Fund Inception&quot;,&quot;formattedValue&quot;:&quot;Jul 22, 2002&quot;,&quot;sortOrder&quot;:11,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:null,&quot;name&quot;:&quot;launchDate&quot;},&quot;premiumDiscountClosingPriceNavPercent&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Premium/Discount&quot;,&quot;formattedValue&quot;:&quot;0.05&quot;,&quot;sortOrder&quot;:111,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The amount the fund’s closing price is trading above or below the reported NAV, expressed as a percentage of the NAV.  When the fund’s closing price is greater than the fund’s NAV, it is said to be trading at a “premium” and the percentage is expressed as a positive number.  When the fund’s closing price is less than the fund’s NAV, it is said to be trading at a “discount” and the percentage is expressed as a negative number.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;premiumDiscountClosingPriceNavPercent&quot;},&quot;sharesOutstanding&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Shares Outstanding&quot;,&quot;formattedValue&quot;:&quot;585,900,000&quot;,&quot;sortOrder&quot;:46,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:&quot;Nov 02, 2026&quot;,&quot;name&quot;:&quot;sharesOutstanding&quot;},&quot;thirtyDayAverageVolume&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;30 Day Avg. Volume&quot;,&quot;formattedValue&quot;:&quot;41,386,667.00&quot;,&quot;sortOrder&quot;:175,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The average number of shares traded in a security across all U.S. exchanges over the last 30 calendar days.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;thirtyDayAverageVolume&quot;},&quot;thirtyDayMedianBidAskSpread&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;30 Day Median Bid/Ask Spread&quot;,&quot;formattedValue&quot;:&quot;0.01%&quot;,&quot;sortOrder&quot;:176,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The median bid-ask spread is calculated by identifying the national best bid and national best offer (&amp;quot;NBBO&amp;quot;) for each fund as of the end of each 10 second interval during each trading day of the last 30 calendar days and dividing the difference between each such bid and offer by the midpoint of the NBBO. The median of those values is identified and that value is expressed as a percentage rounded to the nearest hundredth.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;thirtyDayMedianBidAskSpread&quot;},&quot;totalNetAssetsFundLevel&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Net Assets of Fund&quot;,&quot;formattedValue&quot;:&quot;47,860,489,571&quot;,&quot;sortOrder&quot;:2,&quot;prefix&quot;:&quot;$&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;formattedAsOfDate&quot;:&quot;Nov 02, 2026&quot;,&quot;name&quot;:&quot;totalNetAssetsFundLevel&quot;}}}" componentkey="KeyFundFactsV3"><div webqc-datapoint="keyFundFacts" class="_ws-fund-component _ws-fund-component-container _ws-v3 _ws-full-bleed" data-id="keyFundFacts-container" data-componentname="keyFundFacts" role="region" aria-labelledby="keyFundFacts-header" tabindex="-1"><div class="_ws-container-fluid"><div class="_ws-headline-container _ws-fluid-l"><h2 class="_ws-headline _ws-oneds-heading-l _ws-oneds-overridden-heading-l" data-id="keyFundFacts-header" webqc-datapoint="keyFundFacts-header" id="keyFundFacts-header" data-link-target="">Key Facts</h2></div><div class="_ws-_cardDataListContainer_1v8bz_25"><div class="_ws-_card_1v8bz_25" data-id="keyFundFacts-cards"><div class="_ws-pp-card _ws-card-section" data-id="keyFundFacts-row-totalNetAssetsFundLevel"><div class="_ws-pp-card-item"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-totalNetAssetsFundLevel-label">Net Assets of Fund</span></div><div class="_ws-pp-card-value-group" aria-label="$47,86