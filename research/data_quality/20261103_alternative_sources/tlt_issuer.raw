frequency&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Rebalance Frequency&quot;}],&quot;label.portfolio.regulatory_structure&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Fund Type&quot;}],&quot;label.portfolio.settlement&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Settlement&quot;}],&quot;label.portfolio.shareclasscurrency&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Share Class Currency&quot;}],&quot;label.portfolio.sippeligibilityflag&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;SIPP Available&quot;}],&quot;label.portfolio.stockexchange&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Stock Exchange&quot;}],&quot;label.portfolio.ticker&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Ticker&quot;}],&quot;label.portfolio.ucitsCompliantFlag&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;UCITS&quot;}],&quot;label.portfolio.ucitsEligibleFlag&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;UCITS Eligible&quot;}],&quot;label.portfolio.ukdistributor&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;UK Reporting Status&quot;}],&quot;label.portfolio.underlyingindex&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Benchmark&quot;}],&quot;label.portfolio.useofprofitscode&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Use of Income&quot;}],&quot;label.portfolioidentifier.isin&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;ISIN&quot;}],&quot;label.price_to_cash_flow&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Price To Cash Flow&quot;}],&quot;label.return_on_assets&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Return On Assets&quot;}],&quot;label.return_on_equity&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Return On Equity&quot;}],&quot;label.riskprofile.higherrisk&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Higher Risk/Reward&quot;}],&quot;label.riskprofile.lowerrisk&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Lower Risk/Reward&quot;}],&quot;label.riskprofile.potentialhigherrewards&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Potentially Higher Rewards&quot;}],&quot;label.sector_level_summary.sector&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Sector&quot;}],&quot;label.sector_level_summary.sub_sector&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Sub-sector&quot;}],&quot;label.short&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Short&quot;}],&quot;label.top_bonds.corporate_bonds&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Top 5 Corporate Bonds&quot;}],&quot;label.top_bonds.coupon&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Coupon&quot;}],&quot;label.top_bonds.credit_rating&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Credit Rating&quot;}],&quot;label.top_bonds.government_bonds&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Top 5 Government Bonds&quot;}],&quot;label.top_bonds.industry_sector&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Industry Sector&quot;}],&quot;label.top_bonds.maturity_date&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Maturity Date&quot;}],&quot;label.top_bonds.weight&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Weight&quot;}],&quot;label.top_bonds.yield_to_maturity&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Yield to Maturity&quot;}],&quot;label.topholdings.totalofportfolio&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Total of Portfolio&quot;}],&quot;label.tradinginformation.cusip&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;CUSIP&quot;}],&quot;label.tradinginformation.exchange&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Exchange&quot;}],&quot;label.tradinginformation.totalmarketcapinindex&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Total Index Market Cap&quot;}],&quot;label.unsubsidized30daysecyield&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Unsubsidized 30-Day SEC Yield&quot;}],&quot;label.us_credit_rating.moody&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Moody&#x27;s&quot;}],&quot;label.us_credit_rating.rating&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Rating&quot;}],&quot;label.us_credit_rating.sp&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;S&amp;P&quot;}],&quot;label.yes&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Yes&quot;}],&quot;label.yielddata.distributionyield&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Distribution Yield&quot;}],&quot;label.yielddata.realyieldtomaturity&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Real Yield to Maturity&quot;}],&quot;label.yielddata.trailing12monthyield&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Trailing 12-month Yield&quot;}],&quot;laddered-buffer.expandable-disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Click here for data point definitions&lt;/p&gt;\n&lt;table class=\&quot;disclaimer-table laddered-buffer-disclaimer\&quot;&gt;\n&lt;thead&gt;\n&lt;tr&gt;\n&lt;th&gt;Data Point&lt;/th&gt;&lt;th&gt;Definition&lt;/th&gt;\n&lt;/tr&gt;\n&lt;/thead&gt;\n&lt;tbody&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche Start Date&lt;/td&gt;\n&lt;td&gt;The start date of the Tranche.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche End Date&lt;/td&gt;\n&lt;td&gt;The last day of the Tranche.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Initial Reference Asset Value&lt;/td&gt;\n&lt;td&gt;Price of the Reference Asset as of the close of market on the day before the Tranche Start Date.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche Cap Value&lt;/td&gt;\n&lt;td&gt;The price of the Reference Asset at which the Tranche Cap is reached. The Tranche Cap Value is based on the strike price of the written call options sold in connection with the Tranche. Note that the Fund may not write such call options when they provide limited to no economic value to the Fund and, therefore, the Tranche Cap may at times be greater than indicated.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Initial Tranche Cap Percentage&lt;/td&gt;\n&lt;td&gt;The percentage increase in the Reference Asset Value (as of the Tranche Start Date) until the Tranche Cap Value is reached, determined as of the Tranche Start Date. This is the approximate upside limit for the Tranche. The Initial Tranche Cap Percentage is calculated as follows: (Tranche Cap Value – Reference Asset Value as of the Tranche Start Date) / Reference Asset Value as of the Tranche Start Date.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche Buffer Start Value&lt;/td&gt;\n&lt;td&gt;The price of the Reference Asset at which the downside protection from the Tranche Buffer starts. The Tranche Buffer Start Value is based on the strike price of the put options purchased in the set of FLEX Options included in the Tranche.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Initial Tranche Buffer Start Percentage&lt;/td&gt;\n&lt;td&gt;The percentage reduction in the Reference Asset Value (as of the Tranche Start Date) before the downside protection from the Tranche Buffer starts, determined as of the Tranche Start Date. The Initial Tranche Buffer Start Percentage is calculated as follows: (Tranche Buffer Start Value – Reference Asset Value as of the Tranche Start Date) / Reference Asset Value as of the Tranche Start Date.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche Buffer End Value&lt;/td&gt;\n&lt;td&gt;The price of the Reference Asset at which the downside protection from the Tranche Buffer ends. The Tranche Buffer End Value is based on the strike price of the options written in the set of FLEX Options included in the Tranche.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Initial Tranche Buffer End Percentage&lt;/td&gt;\n&lt;td&gt;The percentage reduction in the Reference Asset Value (as of the Tranche Start Date) before the Tranche reaches the Tranche Buffer End Value, and there is no longer any downside protection, determined as of the Tranche Start Date. The Initial Tranche Buffer End Percentage is calculated as follows: (Tranche Buffer End Value – Reference Asset Value as of the Outcome Tranche Start Date) / Reference Asset Value as of the Outcome Tranche Start Date.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Remaining Tranche Period&lt;/td&gt;\n&lt;td&gt;The days remaining in a Tranche until the Tranche End Date.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Reference Asset Value&lt;/td&gt;\n&lt;td&gt;The current price of the Reference Asset.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Remaining Tranche Cap Percentage&lt;/td&gt;\n&lt;td&gt;The percentage change in the current Reference Asset Value until the Tranche Cap Value is reached and is the current approximate upside limit for the Tranche. The Remaining Tranche Cap Percentage is calculated as follows: (Tranche Cap Value – Reference Asset Value) / Reference Asset Value. On the Tranche Start Date, the Remaining Tranche Cap is the Initial Tranche Cap Percentage.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Reference Asset Value Change to Tranche Buffer Start&lt;/td&gt;\n&lt;td&gt;The percentage change in the current Reference Asset Value until the price of the Reference Asset reaches the Tranche Buffer Start Value and provides downside protection until the Tranche Buffer End Value. The Reference Asset Value Change to Tranche Buffer Start is calculated as follows: (Tranche Buffer Start Value – Reference Asset Value) / Reference Asset Value. At the Tranche Start Date, this is the Initial Tranche Buffer Start Percentage.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Reference Asset Value Change to Tranche Buffer End&lt;/td&gt;\n&lt;td&gt;The percentage change in the current Reference Asset Value until the price of the Reference Asset reaches the Tranche Buffer End Value. The Reference Asset Value Change to Tranche Buffer End is calculated as follows: (Tranche Buffer End Value – Reference Asset Value) / Reference Asset Value. At the Tranche Start Date, this is the Initial Tranche Buffer End Percentage.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;tr&gt;\n&lt;td&gt;Tranche Weight of the Fund&lt;/td&gt;\n&lt;td&gt;The approximate weight of the set of FLEX Options in the Tranche relative to the overall portfolio of the Fund.&lt;/td&gt;\n&lt;/tr&gt;\n&lt;/tbody&gt;\n&lt;/table&gt;\n\n&lt;style&gt;\n\n.laddered-buffer-disclaimer.disclaimer-table,\n._ws-laddered-buffer-disclaimer._ws-disclaimer-table {\n    border-collapse: collapse;\n}\n\n.laddered-buffer-disclaimer.disclaimer-table {\n    font-family: \&quot;ProdFontBLKFortBook\&quot;, Arial, sans-serif;\n}\n\n._ws-oneds-richtext-editor-output ._ws-laddered-buffer-disclaimer._ws-disclaimer-table tbody tr td,\n._ws-oneds-richtext-editor-output ._ws-laddered-buffer-disclaimer._ws-disclaimer-table thead tr th,\n.laddered-buffer-disclaimer.disclaimer-table tbody tr td,\n.laddered-buffer-disclaimer.disclaimer-table thead tr th {\n    vertical-align: top;\n    padding: 12px 20px;\n}\n\n.laddered-buffer-disclaimer.disclaimer-table thead tr th,\n._ws-laddered-buffer-disclaimer._ws-disclaimer-table thead tr th {\n    font-weight: normal;\n}\n\n.laddered-buffer-disclaimer.disclaimer-table tbody tr td:first-child,\n._ws-laddered-buffer-disclaimer._ws-disclaimer-table tbody tr td:first-child {\n    font-weight: bold;\n}\n\n._ws-oneds-richtext-editor-output ._ws-laddered-buffer-disclaimer._ws-disclaimer-table tbody tr,\n.laddered-buffer-disclaimer.disclaimer-table tbody tr {\n    border-bottom: 1px solid #ccc;\n}\n\n._ws-oneds-richtext-editor-output ._ws-laddered-buffer-disclaimer._ws-disclaimer-table tbody tr:last-child,\n.laddered-buffer-disclaimer.disclaimer-table tbody tr:last-child {\n    border-bottom: none;\n}\n\n._ws-oneds-richtext-editor-output ._ws-laddered-buffer-disclaimer._ws-disclaimer-table thead tr,\n.laddered-buffer-disclaimer.disclaimer-table thead tr {\n    border-bottom: 2px solid #333;\n}\n\n._ws-laddered-buffer-disclaimer._ws-disclaimer-table thead tr th {\n    text-align: center;\n}\n\n&lt;/style&gt;&quot;}],&quot;morning_star_ratings.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Rated against fred.mstarFundsOverallData fred.mstarCategory Funds, as of 06/30/2025 based on risk adjusted total return. Overall Ratings are determined monthly and subject to change. The Overall Morningstar Rating for a fund is derived from a weighted average of the performance figures associated with its 3-, 5- and 10-year (if applicable) Morningstar Rating metrics.††&quot;}],&quot;morningstar-analyst-ratings-page2.disclaimer&quot;:[],&quot;morningstar-star-rating-10-year-page2.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;†† The Morningstar RatingTM for funds, or \&quot;star rating\&quot;, is calculated for managed products (including mutual funds, variable annuity and variable life subaccounts, exchange-traded funds, closed-end funds, and separate accounts) with at least a three-year history. Exchange-traded funds and open-ended mutual funds are considered a single population for comparative purposes. It is calculated based on a Morningstar Risk-Adjusted Return measure (excluding any applicable sales charges) that accounts for variation in a managed product&#x27;s monthly excess performance, placing more emphasis on downward variations and rewarding consistent performance. The top 10% of products in each product category receive 5 stars, the next 22.5% receive 4 stars, the next 35% receive 3 stars, the next 22.5% receive 2 stars, and the bottom 10% receive 1 star. The Overall Morningstar Rating for a managed product is derived from a weighted average of the performance figures associated with its three-, five-, and 10-year (if applicable) Morningstar Rating metrics. The weights are: 100% three-year rating for 36-59 months of total returns, 60% five-year rating/40% three-year rating for 60-119 months of total returns, and 50% 10-year rating/30% five-year rating/20% three-year rating for 120 or more months of total returns. While the 10-year overall star rating formula seems to give the most weight to the 10-year period, the most recent three-year period actually has the greatest impact because it is included in all three rating periods. The fund was rated against the following numbers of U.S.-domiciled fred.mstarCategory funds over the following time periods: fred.mstarFundsOverall3yr in the last 3 years, fred.mstarFundsOverall5yr in the last 5 years and fred.mstarFundsOverall10yr in the last 10 years. With respect to these fred.mstarCategory funds, the fund received a Morningstar Rating of fred.mstarRating3yr, fred.mstarRating5yr and fred.mstarRating10yr stars for the 3-, 5- and 10-year periods, respectively. Other classes may have different performance characteristics.&quot;}],&quot;morningstar-star-rating-3-year-page2.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;†† The Morningstar RatingTM for funds, or \&quot;star rating\&quot;, is calculated for managed products (including mutual funds, variable annuity and variable life subaccounts, exchange-traded funds, closed-end funds, and separate accounts) with at least a three-year history. Exchange-traded funds and open-ended mutual funds are considered a single population for comparative purposes. It is calculated based on a Morningstar Risk-Adjusted Return measure (excluding any applicable sales charges) that accounts for variation in a managed product&#x27;s monthly excess performance, placing more emphasis on downward variations and rewarding consistent performance. The top 10% of products in each product category receive 5 stars, the next 22.5% receive 4 stars, the next 35% receive 3 stars, the next 22.5% receive 2 stars, and the bottom 10% receive 1 star. The Overall Morningstar Rating for a managed product is derived from a weighted average of the performance figures associated with its three-, five-, and 10-year (if applicable) Morningstar Rating metrics. The weights are: 100% three-year rating for 36-59 months of total returns, 60% five-year rating/40% three-year rating for 60-119 months of total returns, and 50% 10-year rating/30% five-year rating/20% three-year rating for 120 or more months of total returns. While the 10-year overall star rating formula seems to give the most weight to the 10-year period, the most recent three-year period actually has the greatest impact because it is included in all three rating periods. The fund was rated against the following numbers of U.S.-domiciled fred.mstarCategory funds over the following time period: fred.mstarFundsOverall3yr in the last 3 years. With respect to these fred.mstarCategory funds, the fund received a Morningstar Rating of fred.mstarRating3yr stars for the 3-year period. Other classes may have different performance characteristics.&quot;}],&quot;morningstar-star-rating-5-year-page2.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;†† The Morningstar RatingTM for funds, or \&quot;star rating\&quot;, is calculated for managed products (including mutual funds, variable annuity and variable life subaccounts, exchange-traded funds, closed-end funds, and separate accounts) with at least a three-year history. Exchange-traded funds and open-ended mutual funds are considered a single population for comparative purposes. It is calculated based on a Morningstar Risk-Adjusted Return measure (excluding any applicable sales charges) that accounts for variation in a managed product&#x27;s monthly excess performance, placing more emphasis on downward variations and rewarding consistent performance. The top 10% of products in each product category receive 5 stars, the next 22.5% receive 4 stars, the next 35% receive 3 stars, the next 22.5% receive 2 stars, and the bottom 10% receive 1 star. The Overall Morningstar Rating for a managed product is derived from a weighted average of the performance figures associated with its three-, five-, and 10-year (if applicable) Morningstar Rating metrics. The weights are: 100% three-year rating for 36-59 months of total returns, 60% five-year rating/40% three-year rating for 60-119 months of total returns, and 50% 10-year rating/30% five-year rating/20% three-year rating for 120 or more months of total returns. While the 10-year overall star rating formula seems to give the most weight to the 10-year period, the most recent three-year period actually has the greatest impact because it is included in all three rating periods. The fund was rated against the following numbers of U.S.-domiciled fred.mstarCategory funds over the following time periods: fred.mstarFundsOverall3yr in the last 3 years and fred.mstarFundsOverall5yr in the last 5 years. With respect to these fred.mstarCategory funds, the fund received a Morningstar Rating of fred.mstarRating3yr and fred.mstarRating5yr stars for the 3-and 5-year periods, respectively. Other classes may have different performance characteristics.&quot;}],&quot;performance-scenario.upper-disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The EU Packaged Retail and Insurance-Based Products Regulation (PRIIPs) prescribes the calculation methodology, and publication of the outcomes, of four hypothetical performance scenarios regarding how the product may perform under certain conditions and for such to be published on a monthly basis. The figures shown include all the costs of the product itself, but may not include all the costs that you pay to your advisor or distributor. The figures do not take into account your personal tax situation, which may also affect how much you get back. What you will get from this product depends on future market performance. Market developments in the future are uncertain and cannot be accurately predicted. The unfavourable, moderate, and favourable scenarios shown are illustrations using the worst, average, and best performance of the product, which may include input from benchmark(s) / proxy, over the last ten years.&quot;}],&quot;performance.chart.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The Hypothetical Growth of $10,000 chart reflects a hypothetical $10,000 investment and assumes reinvestment of dividends and capital gains. Fund expenses, including management fees and other expenses were deducted. &lt;br /&gt;&lt;br /&gt;The performance quoted represents past performance and does not guarantee future results. Investment return and principal value of an investment will fluctuate so that an investor’s shares, when sold or redeemed, may be worth more or less than the original cost. Current performance may be lower or higher than the performance quoted, and numbers may reflect small variances due to rounding. Standardized performance and performance data current to the most recent month end may be found in the Performance section. &lt;br /&gt;&lt;br /&gt;&quot;}],&quot;performance.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;The performance quoted represents past performance and does not guarantee future results. Investment return and principal value of an investment will fluctuate so that an investor’s shares, when sold or redeemed, may be worth more or less than the original cost. Current performance may be lower or higher than the performance quoted. Performance data current to the most recent month end may be obtained by visiting &lt;a href=\&quot;http://www.iShares.com\&quot;&gt;www.iShares.com&lt;/a&gt; or &lt;a href=\&quot;http://www.blackrock.com\&quot;&gt;www.blackrock.com&lt;/a&gt;.&lt;/strong&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Beginning 8/10/20, the market price returns are calculated using the closing price. &lt;br /&gt;Prior to 8/10/20, the market price returns were calculated using the midpoint of the bid/ask spread at 4:00 PM ET. The returns shown do not represent the returns you would receive if you traded shares at other times.&quot;}],&quot;performance.premium-discount-chart.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Shareholders may pay more than NAV when buying fund shares and receive less than NAV when selling fund shares, because shares are bought and sold at current market prices. The performance quoted represents past performance and does not guarantee future results.&lt;/p&gt;&quot;}],&quot;performance.returns.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;em&gt;The performance quoted represents past performance and does not guarantee future results. Investment return and principal value of an investment will fluctuate so that an investor&#x27;s shares, when sold or redeemed, may be worth more or less than the original cost. Current performance may be lower or higher than the performance quoted.&lt;/em&gt;&quot;}],&quot;performance.systematic-fair-value.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The ETF total return may appear to diverge from the return of its benchmark. This may be due to the use of systematic fair value. &lt;span&gt;&lt;strong&gt;&lt;a href=\&quot;#disclaimerDialog\&quot; data-modaltitle=\&quot;Understanding Systematic Fair Value\&quot; data-link-event=\&quot;managers:test:Click here\&quot;&gt;Click here for more information&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;&quot;}],&quot;performance.systematic-fair-value.module&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;style&gt;\n .nfvNavPerformance {\n    color: black !important;\n    font-weight: bold !important;\n}\n&lt;/style&gt;\n&lt;div id=\&quot;systFairValueModule\&quot;&gt;The ETF total return is based on the ETF’s net asset value, which uses systematic fair value to price certain foreign assets as of 4:00 p.m. Eastern time (when foreign markets may be closed). The benchmark return uses local market closing prices which may differ from systematic fair value prices. This difference may result in divergence of ETF total return and benchmark return. For more information, please consult the fund’s prospectus. &lt;span&gt;&lt;strong&gt;&lt;a class=\&quot;nfvNavPerformance\&quot; href=\&quot;https://www.ishares.com/us/library?keyword=nfvnavperformance\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;Institutional Non-Fair Value Impact Report&lt;/a&gt;&lt;/strong&gt;&lt;/span&gt;\n&lt;/div&gt;\n&quot;}],&quot;portfolio_characteristics.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Weighted Average Maturity&lt;/strong&gt; is the length of time until the average security in the fund will mature or be redeemed by its issuer. It indicates a fixed income fund&#x27;s sensitivity to interest rate changes. Longer average weighted maturity implies greater volatility in response to interest rate changes.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Effective Duration&lt;/strong&gt; is a measure of the potential responsiveness of a bond or portfolio price to small parallel shifts in interest rates. Effective Duration takes into account the possible changes in expected bond cash flows due to small parallel shifts in interest rates.&quot;}],&quot;portfolio_management&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;iShares ETFs are managed by investment professionals who have experience operating funds in all types of market environments. The Portfolio Management Team continually balances a variety of trade-offs in attempting to meet each fund’s investment objective and maximize tax efficiency.&quot;}],&quot;pphero.exposures.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer-source\&quot;&gt;Disclaimer&lt;/p&gt;\n&lt;p&gt;Allocations are subject to change&lt;/p&gt;&quot;}],&quot;pphero.exposures.story&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;When you buy IVV, you&#x27;re buying shares (or stocks) of exposure to the S&amp;amp;P 500, and getting broad market access to hundreds of the largest companies in the U.S. This diversified fund can be used as a foundational holding in your portfolio to seek long-term growth over time.&quot;}],&quot;pphero.exposures.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;A focus on broad exposure&quot;}],&quot;pphero.fees.bulletpoints&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;ul&gt;\n&lt;li&gt;\n&lt;span class=\&quot;data\&quot;&gt;500&lt;/span&gt;&lt;span class=\&quot;label\&quot;&gt;of the largest U.S. stocks.&lt;/span&gt;\n&lt;/li&gt;\n&lt;li&gt;\n&lt;span class=\&quot;data\&quot;&gt;100&amp;#43;&lt;/span&gt;&lt;span class=\&quot;label\&quot;&gt;investment professionals including portfolio engineers, traders and researchers.&lt;/span&gt;\n&lt;/li&gt;\n&lt;/ul&gt;\n&lt;p style=\&quot;text-align:left\&quot;&gt;*Data as of March 31, 2019&lt;/p&gt;&quot;}],&quot;pphero.fees.story&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The short answer is yes — but there’s good news. For exchange traded funds (ETFs) like IVV, the costs are low compared to mutual funds.  The very small amount you do pay in fees is used to help manage your investment: from the basics to the big stuff such as our powerful &lt;a href=\&quot;https://www.blackrock.com/aladdin\&quot; target=\&quot;_blank\&quot; class=\&quot;aladdin-link\&quot;&gt;Aladdin&lt;/a&gt; investment platform, intensive, proprietary research, and some of the most experienced teams in the industry.&quot;}],&quot;pphero.fees.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Does it really take money to make money?&quot;}],&quot;pphero.fund-header.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Exposure to American companies&quot;}],&quot;pphero.fundheader.description&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The iShares Core S&amp;amp;P 500 ETF (Ticker: IVV) provides low cost, tax efficient access to the S&amp;amp;P 500 Index. The S&amp;amp;P 500 contains some of the largest and most well-known U.S.-based companies across a variety of industries.&quot;}],&quot;pphero.hypothetical.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer-source\&quot; style=\&quot;font-size: 14px;\&quot;&gt;Source&lt;/p&gt;\n\n&lt;p style=\&quot;font-family: BLKFortItalic; font-size: 14px; line-height: 17px;\&quot;&gt;The chart reflects a hypothetical investment and assumes reinvestment of dividends and capital gains. Fund expenses, including management fees and other expenses were deducted.&lt;/p&gt;\n\n&lt;p style=\&quot;font-family: BLKFortItalic; font-size: 14px; line-height: 17px;\&quot;&gt;The performance quoted represents past performance and does not guarantee future results. Investment return and principal value of an investment will fluctuate so that an investor’s shares, when sold or redeemed, may be worth more or less than the original cost. Current performance may be lower or higher than the performance quoted, and numbers may reflect small variances due to rounding. For standardized performance and performance data current to the most recent month end, please click on the product ticker to view full fund details.&lt;/p&gt;&quot;}],&quot;pphero.hypothetical.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;span&gt;Curious how an investment could have grown?&lt;/span&gt;&quot;}],&quot;pphero.nextsteps.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer-source\&quot;&gt;Disclaimer&lt;/p&gt;\n&lt;p class=\&quot;emphasis\&quot;&gt;Carefully consider the Funds&#x27; investment objectives, risk factors, and charges and expenses before investing. This and other information can be found in the Funds&#x27; prospectuses or, if available, the summary prospectuses, which may be obtained by visiting the iShares ETF and BlackRock Fund prospectus pages. Read the prospectus carefully before investing. Investing involves risk, including possible loss of principal.&lt;/p&gt;\n&lt;br /&gt;\n&lt;p class=\&quot;italic\&quot;&gt;&lt;span&gt;Before engaging Fidelity or any broker-dealer, you should evaluate the overall fees and charges of the firm as well as the services provided. Free commission offer applies to online purchases of select iShares ETFs in a Fidelity account. The sale of ETFs is subject to an activity assessment fee (from $0.01 to $0.03 per $1,000 of principal). For iShares ETFs, Fidelity receives compensation from the ETF sponsor and/or its affiliates in connection with an exclusive long-term marketing program that includes promotion of iShares ETFs and inclusion of iShares funds in certain Fidelity Brokerage Services platforms and investment programs. Please note, this security will not be marginable for 30 days from the settlement date, at which time it will automatically become eligible for margin collateral. Additional information about the sources, amounts, and terms of compensation can be found in the ETF’s prospectus and related documents. Fidelity may add or waive commissions on ETFs without prior notice.&lt;/span&gt;&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;This information should not be relied upon as research, investment advice, or a recommendation regarding any products, strategies, or any security in particular. This material is strictly for illustrative, educational, or informational purposes and is subject to change.&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;The Funds are distributed by BlackRock Investments, LLC (together with its affiliates, “BlackRock”).&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;©2019 BlackRock, Inc. All rights reserved. BLACKROCK, BLACKROCK SOLUTIONS, BUILD ON BLACKROCK, ALADDIN, iSHARES, iBONDS, iTHINKING, iSHARES CONNECT, FUND FRENZY, LIFEPATH, SO WHAT DO I DO WITH MY MONEY, INVESTING FOR A NEW WORLD, BUILT FOR THESE TIMES, the iShares Core Graphic, CoRI and the CoRI logo are registered and unregistered trademarks of BlackRock, Inc., or its subsidiaries in the United States and elsewhere. All other marks are the property of their respective owners.&lt;/p&gt;&quot;}],&quot;pphero.nextsteps.email.story&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This fund may be an excellent addition to an investment portfolio. Before investing, it&#x27;s always a good idea to check with your financial advisor to be sure that you are meeting your financial goals.&quot;}],&quot;pphero.nextsteps.email.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Start the Conversation&lt;/p&gt;&quot;}],&quot;pphero.nextsteps.fidelity.story&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;The fund is available commission-free at Fidelity.&lt;/p&gt;&quot;}],&quot;pphero.nextsteps.fidelity.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Ready to Buy?&lt;/p&gt;&quot;}],&quot;pphero.nextsteps.learn-more&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;If you&#x27;re still learning about this fund, download the fact sheet or visit the fund page.&lt;/p&gt;&quot;}],&quot;pphero.overview.tagline&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Is This Fund a Good Fit?&quot;}],&quot;priips-annual-cost-impact-rhp-less-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Cost impact (*)&quot;}],&quot;priips-annual-cost-impact-rhp-more-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Annual cost Impact (*)&quot;}],&quot;priips-average-return-year.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Average return each year&quot;}],&quot;priips-complaint.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;How can I complain?&quot;}],&quot;priips-complaint.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If you are not entirely satisfied with any aspect of the service you have received and you wish to complain, details of our complaints handling process are available at www.blackrock.com/uk/individual/about-blackrock/contact-us. Additionally, you can also write to the Investor Services Team, at BlackRock’s UK Registered Office, 12 Throgmorton Avenue, London, EC2N 2DL or e-mail them at enquiry@ukclientservices.blackrock.com.&quot;}],&quot;priips-composition-of-cost-header.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The table below shows:&quot;}],&quot;priips-composition-of-costs-footer-astersik-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Please refer to the person selling you or advising you about this product for the actual charges.&quot;}],&quot;priips-composition-of-costs-footer-astersik-2.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This figure is based on estimated costs, often referencing historic data, and therefore the actual costs paid by an investor may differ.&quot;}],&quot;priips-composition-of-costs-footer-header.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This table shows the impact each year of the different types of costs on the investment return you might get at the end of the recommended holding period and the meaning of the different cost categories.&quot;}],&quot;priips-composition-of-costs-header-subtitle.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;the impact each year of the different types of costs on the investment return you might get at the end of the recommended holding period.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;the meaning of the different cost categories.&quot;}],&quot;priips-composition-of-costs.disclaimer.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;sup&gt;1&lt;/sup&gt;Not applicable to secondary market investors. Investors dealing via stock exchanges will pay fees charged by stock brokers. Such charges can be obtained on exchanges where the shares are listed and traded, or from stock brokers. Authorised participants dealing directly with the Fund or the Management Company will pay related transaction costs.&quot;}],&quot;priips-comprehension-alert.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Caution: You are about to purchase a product that is not simple and may be difficult to understand.&lt;/strong&gt;&quot;}],&quot;priips-costs-over-time.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The person selling you or advising you about this product may charge you other costs. If so, this person will provide you with information about these costs, and show you the impact that all costs will have on your investment over time.&quot;}],&quot;priips-costs.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What are the costs?&quot;}],&quot;priips-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The person advising on or selling you this product may charge you other costs. If so, this person will provide you with information about these costs and how they affect your investment.&quot;}],&quot;priips-favourable-scenario.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Favourable&quot;}],&quot;priips-header.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Key Information Document&quot;}],&quot;priips-if-you-exit-after-rhp.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If you exit after recommended holding period&quot;}],&quot;priips-if-you-exit-after.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If you exit after&quot;}],&quot;priips-intended-target-mkt-investor&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Retail and Professional Investors.&quot;}],&quot;priips-intended-target-mkt-investor-tokenised&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;In addition, investors should be familiar with blockchain technology, tokenisation and understand the associated risks.&quot;}],&quot;priips-investment.benchmark&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This type of scenario occurred for an investment in the product with input from benchmark(s) / proxy during&quot;}],&quot;priips-investment.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The stress scenario shows what you might get back in extreme market circumstances.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The figures shown include all the costs of the product itself, but may not include all the costs that you pay to your broker, financial adviser or distributor. The figures do not take into account your personal tax situation, which may also affect how much you get back.&quot;}],&quot;priips-investment.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Example Investment&quot;}],&quot;priips-investment.label.ukpriip&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Investment&quot;}],&quot;priips-minimum.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Minimum&quot;}],&quot;priips-minimum.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;There is no minimum guaranteed return. You could lose some or all of your investment.&quot;}],&quot;priips-moderate-scenario.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Moderate&quot;}],&quot;priips-month.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;month&quot;}],&quot;priips-months.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;months&quot;}],&quot;priips-other-relevant-info.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Other relevant information&quot;}],&quot;priips-other-relevant-info.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The benchmark(s) referenced herein are the intellectual property of the index provider(s). The product is not sponsored or endorsed by the index provider(s). Please refer to the product’s prospectus and/or www.blackrock.com for full disclaimer(s).&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The Remuneration Policy of the Management Company, which describes how remuneration and benefits are determined and awarded, and the associated governance arrangements, is available at www.blackrock.com/Remunerationpolicy or on request from the registered office of the Manager.&quot;}],&quot;priips-other-relevant-pastperformance-cat1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The latest copy of this document, the Fund’s prospectus, the latest annual report and any additional information issued to investors can be obtained from your distributor.&quot;}],&quot;priips-other-relevant-risk-narrative&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Refer to the UCITS KIID or PRIIPs KID for risk disclosures&quot;}],&quot;priips-presentation-of-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The Reduction in Yield (RIY) shows what impact the total costs you pay will have on the investment return you might get. The total costs take into account one-off, ongoing and incidental costs.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The amounts shown here are the cumulative costs of the product itself, for one or more different holding periods. The figures assume you invest USD 10,000. The figures are estimates and may change in the future.&quot;}],&quot;priips-product-details.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Product&quot;}],&quot;priips-product-details.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;fred.fundProspectusName&lt;/strong&gt; (the “Fund”), &lt;strong&gt;fred.investorClassCode fred.useOfProfit USD&lt;/strong&gt; (the \&quot;Unit Class\&quot;/\&quot;Share Class\&quot;), ISIN: &lt;strong&gt;US4642874329&lt;/strong&gt;&quot;}],&quot;priips-product-type.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What is this product?&quot;}],&quot;priips-product-type.insurance-benefits.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Insurance benefits:&lt;/strong&gt;&quot;}],&quot;priips-product-type.insurance-benefits.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The Fund does not offer any insurance benefits.&quot;}],&quot;priips-product-type.intended-retail-inv.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Intended retail investor:&lt;/strong&gt;&quot;}],&quot;priips-product-type.objective-tokenised.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Tokenised Shares Risk: Tokenised Shares rely on blockchain and tokenisation arrangements, and failures, disruptions, cyber incidents, or regulatory or operational changes may result in restricted or lost access to investments, difficulties in transfer or redemption, or the loss of some or all invested capital.&quot;}],&quot;priips-product-type.objective.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Objectives&quot;}],&quot;priips-product-type.term.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Term:&lt;/strong&gt;&quot;}],&quot;priips-product-type.type.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Type:&lt;/strong&gt;&quot;}],&quot;priips-product-type.type.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Fund authorised as a UCITS product.&quot;}],&quot;priips-proxy-disclaimer.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This type of scenario occurred for an investment in the product and/or benchmark(s) or proxy between :&quot;}],&quot;priips-proxy-favourable.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This type of scenario occurred for an investment in the product and/or benchmark(s) or proxy between&quot;}],&quot;priips-proxy-moderate.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This type of scenario occurred for an investment in the product and/or benchmark(s) or proxy between&quot;}],&quot;priips-proxy-unfavourable.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This type of scenario occurred for an investment in the product and/or benchmark(s) or proxy between&quot;}],&quot;priips-purpose.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Purpose&quot;}],&quot;priips-purpose.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This document provides you with key information about this investment product. It is not marketing material. The information is required by law to help you understand the nature, risks, costs, potential gains and losses of this product and to help you compare it with other products.&quot;}],&quot;priips-relevant-risk-narrative-cat1-common&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The actual risk can vary significantly if you cash in at an early stage and you may get back less. You may not be able to cash in early. You may not be able to sell your product easily or you may have to sell at a price that significantly impacts on how much you get back.&quot;}],&quot;priips-relevant-risk-narrative-common&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The actual risk can vary significantly if you cash in at an early stage and you may get back less.&quot;}],&quot;priips-relevant-risk-narrative-rhp-in-month&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The risk indicator assumes you keep the product for 1 month.&quot;}],&quot;priips-relevant-risk-narrative-rhp-in-months&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The risk indicator assumes you keep the product for &lt;recommendedHoldingPeriod/&gt; months.&quot;}],&quot;priips-relevant-risk-narrative-rhp-less-than-1&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The risk indicator assumes you keep the product for &lt;recommendedHoldingPeriod/&gt; year.&quot;}],&quot;priips-relevant-risk-narrative-rhp-more-than-1&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The risk indicator assumes you keep the product for &lt;recommendedHoldingPeriod/&gt; years.&quot;}],&quot;priips-rhp-year.sub-text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Recommended holding period&quot;}],&quot;priips-rhp.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;How long should I hold it and can I take money out early?&quot;}],&quot;priips-rhp.sub-header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Recommended Holding Period: &lt;recommendedHoldingPeriod/&gt;&quot;}],&quot;priips-rhp.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The recommended holding period (RHP) has been calculated in line with the investment strategy of the Fund and the time frame in which it is expected that it will be possible to achieve the investment objective of the Fund. Any investment should be considered against your specific investment needs and appetite for risk. BlackRock has not considered the suitability or appropriateness of this investment for your personal circumstances. If you are in any doubt about the suitability of the Fund to your needs you should seek appropriate professional advice. Details of dealing frequency can be found under “What is this product?”. You may receive less than expected if you cash in earlier than the RHP. The RHP is an estimate and must not be taken as a guarantee or an indication of future performance, return or risk levels. Please see the “What are the costs?” section for details of any exit fees.&quot;}],&quot;priips-risk&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Be aware of currency risk.&lt;/strong&gt; If you receive payments in a currency that is different to the product&#x27;s base currency, the final return you will get depends on the exchange rate between the two currencies. This risk is not considered in the indicator shown above.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Please refer to the product&#x27;s Prospectus for details of other materially relevant risks that may apply to this product.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This product does not include any protection from future market performance so you could lose some or all of your investment.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If the product is not able to pay you what is owed, you could lose your entire investment.&quot;}],&quot;priips-risk-rewards.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What are the risks and what could I get in return?&quot;}],&quot;priips-risk-rewards.indicator-higher.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Higher risk&quot;}],&quot;priips-risk-rewards.indicator-lower.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Lower risk&quot;}],&quot;priips-risk-rewards.indicator.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Risk Indicator&quot;}],&quot;priips-risk-rewards.perf-scenario-cat2-not.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The scenarios shown are illustrations based on results from the past and on certain assumptions. Markets could develop very differently in the future. This product cannot be cashed in. This means it is difficult to estimate how much you would get back if you cash in before the end of the recommended holding period. You will either be unable to cash in early (or you will have to pay high costs) or make a large loss if you do so.&quot;}],&quot;priips-risk-rewards.perf-scenario-cat2.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The unfavourable, moderate, and favourable scenarios shown are illustrations using the worst, average, and best performance of the product, which may include input from benchmark(s) / proxy, over the last ten years. Markets could develop very differently in the future.&quot;}],&quot;priips-risk-rewards.perf-scenario-common-top.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The figures shown include all the costs of the product itself, but may not include all the costs that you pay to your advisor or distributor. The figures do not take into account your personal tax situation, which may also affect how much you get back. What you will get from this product depends on future market performance. Market developments in the future are uncertain and cannot be accurately predicted.&quot;}],&quot;priips-risk-rewards.perf-scenario.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Performance Scenarios&quot;}],&quot;priips-risk-sri-1&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 1 out of 7, which is the lowest risk class. This classification rates the potential losses from future performance at a very low level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-2&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 2 out of 7, which is a low risk class. This classification rates the potential losses from future performance at a low level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-3&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 3 out of 7, which is a medium low risk class. This classification rates the potential losses from future performance at a medium low level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-4&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 4 out of 7, which is a medium risk class. This classification rates the potential losses from future performance at a medium level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-5&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 5 out of 7, which is a medium high risk class. This classification rates the potential losses from future performance at a medium high level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-6&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 6 out of 7, which is the second highest risk class. This classification rates the potential losses from future performance at a high level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-sri-7&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have classified this product as 7 out of 7, which is the highest risk class. This classification rates the potential losses from future performance at a very high level, and poor market conditions could affect the value of your investment. This classification is not guaranteed and may change over time and may not be a reliable indication of the future risk profile of the Fund. The lowest category does not mean risk free.&quot;}],&quot;priips-risk-summary&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The summary risk indicator is a guide to the level of risk of this product compared to other products. It shows how likely it is that the product will lose money because of movements in the markets or because we are not able to pay you.&quot;}],&quot;priips-scenario.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Scenarios&quot;}],&quot;priips-stress-scenario.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Stress&quot;}],&quot;priips-type-of-underlying-inv-option&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Fund is a UCITS or PRIIPs product.&quot;}],&quot;priips-uk.perf-scenario-negative-return.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What could affect my return negatively?&quot;}],&quot;priips-uk.perf-scenario-positive-return.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What could affect my return positively?&quot;}],&quot;priips-uk.risk-rewards.perf-scenario.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Investment performance information&quot;}],&quot;priips-unfavourable-scenario.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Unfavourable&quot;}],&quot;priips-we-have-assumed-bottom-common-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We may share part of the costs with the person selling you the product to cover the services they provide to you. They will inform you of the amount.&quot;}],&quot;priips-we-have-assumed-bottom-common-2.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;These figures include the maximum distribution fee that the person selling you the product may charge (fred.frontCostPercent % of amount invested/ fred.frontCostAmt USD). This person will inform you of the actual distribution fee.&quot;}],&quot;priips-we-have-assumed-bottom-common-3.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We do not charge an entry fee for this product, but the person selling you the product may do so up to fred.subscriptionFee%&quot;}],&quot;priips-we-have-assumed-bottom-rhp-less-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;(*) This illustrates the effect of costs over a holding period of less than one year. This percentage cannot be directly compared to the cost impact figures provided for other PRIIPs.&quot;}],&quot;priips-we-have-assumed-bottom-rhp-more-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;(*) This illustrates how costs reduce your return each year over the holding period. For example it shows that if you exit at the recommended holding period your average return per year is projected to be fred.grossReturn% before costs and fred.longModerateFelBelAnn% after costs.&quot;}],&quot;priips-we-have-assumed-top-currency.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;USD fred.investmentAmount is invested.&quot;}],&quot;priips-we-have-assumed-top-rhp-less-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;You would get back the amount that you invested (0 % annual return).&quot;}],&quot;priips-we-have-assumed-top-rhp-more-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;In the first year you would get back the amount that you invested (0 % annual return).&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;For the other holding periods we have assumed the product performs as shown in the moderate scenario.&quot;}],&quot;priips-what-you-might-get-back-after-cost&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;What you might get back after costs&quot;}],&quot;priips-year.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;year&quot;}],&quot;priips-years.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;years&quot;}],&quot;priips.carried-interests&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Carried interests&quot;}],&quot;priips.carried-interests-alt.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;There are no carried interests for this product.&quot;}],&quot;priips.carried-interests.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The impact of the carried interests.&quot;}],&quot;priips.composition-of-costs.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Composition of Costs&quot;}],&quot;priips.costs-over-time-rhp-less-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Costs over time:&lt;/strong&gt; The tables show the amounts that are taken from your investment to cover different types of costs. These amounts depend on how much you invest and how long you hold the product. The amounts shown here are illustrations based on an example investment amount and different possible investment periods.&quot;}],&quot;priips.costs-over-time-rhp-more-than-1.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Costs over time:&lt;/strong&gt; The tables show the amounts that are taken from your investment to cover different types of costs. These amounts depend on how much you invest, how long you hold the product and how well the product does. The amounts shown here are illustrations based on an example investment amount and different possible investment periods.&quot;}],&quot;priips.entry-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Entry costs&quot;}],&quot;priips.entry-costs-alt.text-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We do not charge an entry fee.*&quot;}],&quot;priips.entry-costs-alternative.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We do not charge an entry fee.&lt;sup&gt;1&lt;/sup&gt;&quot;}],&quot;priips.entry-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;of the amount you pay. This is the most you will be charged. The person selling you the product will inform you of the actual charge.&lt;sup&gt;1&lt;/sup&gt;&quot;}],&quot;priips.entry-costs.text-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The impact of the costs you pay when entering your investment.*&quot;}],&quot;priips.exit-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Exit costs&quot;}],&quot;priips.exit-costs-alt.text-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We do not charge an exit fee.*&quot;}],&quot;priips.exit-costs-alternative.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We do not charge an exit fee.&lt;sup&gt;1&lt;/sup&gt;&quot;}],&quot;priips.exit-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;of your investment before it is paid out to you. This is the most you will be charged. The person selling you the product will inform you of the actual charge.&lt;sup&gt;1&lt;/sup&gt;&quot;}],&quot;priips.exit-costs.text-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The impact of the costs of exiting your investment when it matures.*&quot;}],&quot;priips.if-you-cash-in-after.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If you cash in after&quot;}],&quot;priips.impact-on-return-year.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Impact on return (RIY) per year&quot;}],&quot;priips.incidental-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Incidental costs taken under specific conditions&quot;}],&quot;priips.incidental-costs-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Incidental costs&quot;}],&quot;priips.mgmt-fee-and-other-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Management fees and other administrative or operating costs&quot;}],&quot;priips.mgmt-fee-and-other-costs-alt.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;of the value of your investment per year. This is based on estimated costs. Any underlying product costs are included here with the exception of transaction costs which would be included below under &#x27;Transaction costs&#x27;.&quot;}],&quot;priips.mgmt-fee-and-other-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;of the value of your investment per year. This is based on a combination of estimated and actual costs data over the last year. Any underlying product costs are included here with the exception of transaction costs which would be included below under &#x27;Transaction costs&#x27;.&quot;}],&quot;priips.month.april&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;April&quot;}],&quot;priips.month.august&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;August&quot;}],&quot;priips.month.december&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;December&quot;}],&quot;priips.month.february&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;February&quot;}],&quot;priips.month.january&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;January&quot;}],&quot;priips.month.july&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;July&quot;}],&quot;priips.month.june&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;June&quot;}],&quot;priips.month.march&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;March&quot;}],&quot;priips.month.may&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;May&quot;}],&quot;priips.month.november&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;November&quot;}],&quot;priips.month.october&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;October&quot;}],&quot;priips.month.september&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;September&quot;}],&quot;priips.one-off-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;One-off costs upon entry or exit&quot;}],&quot;priips.one-off-costs-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;One-off costs&quot;}],&quot;priips.ongoing-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Ongoing costs taken each year&quot;}],&quot;priips.ongoing-costs-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Ongoing costs&quot;}],&quot;priips.other-ongoing-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Other ongoing costs&quot;}],&quot;priips.other-ongoing-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The impact of the costs that we take each year for managing your investments. Any underlying product costs are included here with the exception of transaction costs which would be included above under &#x27;Portfolio transaction costs&#x27;.**&quot;}],&quot;priips.performance-fee-carried-interest&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Performance fees&quot;}],&quot;priips.performance-fees-alt.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;There is no performance fee for this product.&quot;}],&quot;priips.total-cost.label&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Total costs&quot;}],&quot;priips.transaction-costs&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Transaction costs&quot;}],&quot;priips.transaction-costs-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Portfolio transaction costs&quot;}],&quot;priips.transaction-costs.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;of the value of your investment per year. This is an estimate of the costs incurred when we buy and sell the underlying investments for the product. The actual amount will vary depending on how much we buy and sell.&quot;}],&quot;priips.transaction-costs.text-ukpriips&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The impact of the costs of us buying and selling underlying investments for the product.&quot;}],&quot;priips.transaction-costs.tokenised.text&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;This figure includes gas fees charged for subscriptions only but excludes gas fees charged for redemptions and transfers which are payable by the investor.&quot;}],&quot;priips.we-have-assumed.header&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;We have assumed:&quot;}],&quot;product-involvement.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Business Involvement metrics are calculated by BlackRock using data from MSCI ESG Research which provides a profile of each company’s specific business involvement. BlackRock leverages this data to provide a summed up view across holdings and translates it to a fund&#x27;s market value exposure to the listed Business Involvement areas above.&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;&lt;strong&gt;Business Involvement metrics are designed only to identify companies where MSCI has conducted research and identified as having involvement in the covered activity. As a result, it is possible there is additional involvement in these covered activities where MSCI does not have coverage. This information should not be used to produce comprehensive lists of companies without involvement. Business Involvement metrics are only displayed if at least 1% of the fund’s gross weight includes securities covered by MSCI ESG Research.&lt;/strong&gt;&lt;/p&gt;&quot;}],&quot;product-involvement.subtitle&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;Business Involvement metrics can help investors gain a more comprehensive view of specific activities in which a fund may be exposed through its investments.&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;Business Involvement metrics are not indicative of a fund’s investment objective, and, unless otherwise stated in fund documentation and included within a fund’s investment objective, do not change a fund’s investment objective or constrain the fund’s investable universe. For more information regarding a fund&#x27;s investment strategy, please see the fund&#x27;s prospectus.&lt;/p&gt;\n&lt;br /&gt;\n&lt;p&gt;Review the MSCI methodology behind the Business Involvement metrics, using links &lt;strong&gt;&lt;a href=\&quot;#esg-footer\&quot;&gt;below.&lt;/a&gt;&lt;/strong&gt;&lt;/p&gt;&quot;}],&quot;product-literature.default&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;{type=GLS;material=Product Brief}{type=GLS;material=Investor Guide}{type=GLS;material=Fact Sheet}{type=GLS;material=Prospectus}{type=GLS;material=Summary Prospectus}{type=GLS;material=Annual Report}{type=GLS;material=Semi-Annual Report}{type=GLS;material=Annual Financial Statements}{type=GLS;material=Semi-Annual Financial Statements}&quot;}],&quot;product-literature.gls-document-ids&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;2192026,947649&lt;/p&gt;&quot;}],&quot;product-page.footer.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclosure-16\&quot;&gt;&lt;strong&gt;Carefully consider the Funds&#x27; investment objectives, risk factors, and charges and expenses before investing. This and other information can be found in the Funds&#x27; prospectuses or, if available, the summary prospectuses, which may be obtained by visiting the &lt;a href=\&quot;https://www.blackrock.com/us/individual/resources/regulatory-documents#etfs\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;iShares Fund&lt;/a&gt; and &lt;a href=\&quot;https://www.blackrock.com/us/individual/resources/regulatory-documents#mutualfunds\&quot; target=\&quot;_blank\&quot; title=\&quot;BlackRock Fund\&quot; rel=\&quot;noopener\&quot;&gt;BlackRock Fund&lt;/a&gt; prospectus pages. Read the prospectus carefully before investing.&lt;/strong&gt;&lt;/p&gt;&lt;br /&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;span style=\&quot;font-size:15px\&quot;&gt;&lt;strong&gt;Investing involves risk, including possible loss of principal.&lt;/strong&gt;&lt;/span&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;If the Fund invests in any underlying fund, certain portfolio information, including sustainability characteristics and business-involvement metrics, provided for the Fund may include information (on a look-through basis) of such underlying fund, to the extent available.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer\&quot;&gt;Fixed income risks include interest-rate and credit risk. Typically, when interest rates rise, there is a corresponding decline in the value of debt securities. Credit risk refers to the possibility that the debt issuer will not be able to make principal and interest payments.&lt;/p&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;An investment in the Fund is not insured or guaranteed by the Federal Deposit Insurance Corporation or any other government agency and its return and yield will fluctuate with market conditions.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Shares of ETFs are bought and sold at market price (not NAV) and are not individually redeemed from the fund. Any applicable brokerage commissions will reduce returns. Beginning August 10, 2020, market price returns for BlackRock and iShares ETFs are calculated using the closing price and account for distributions from the fund. Prior to August 10, 2020, market price returns for BlackRock and iShares ETFs were calculated using the midpoint price and accounted for distributions from the fund. The midpoint is the average of the bid/ask prices at 4:00 PM ET (when NAV is normally determined for most ETFs). The returns shown do not represent the returns you would receive if you traded shares at other times.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;strong&gt;Index returns are for illustrative purposes only. Index performance returns do not reflect any management fees or expenses. Indexes are unmanaged and one cannot invest directly in an index. Past performance does not guarantee future results.&lt;/strong&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;After-tax returns are calculated using the historical highest individual federal marginal income tax rates and do not reflect the impact of state and local taxes. Actual after-tax returns depend on the investor&#x27;s tax situation and may differ from those shown. The after-tax returns shown are not relevant to investors who hold their fund shares through tax-deferred arrangements such as 401(k) plans or individual retirement accounts.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Certain sectors and markets perform exceptionally well based on current market conditions and iShares and BlackRock Funds can benefit from that performance. Achieving such exceptional returns involves the risk of volatility and investors should not expect that such results will be repeated.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Distribution Yield and 12m Trailing Yield results may have period over period volatility due to factors including tax considerations such as treatment of passive foreign investment companies (PFICs), treatment of defaulted bonds or excise tax requirements; exceptional corporate actions; seasonality of dividends from underlying holdings; significant fluctuations in fund shares outstanding; or fund capital gain distributions.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The Funds are distributed by BlackRock Investments, LLC (together with its affiliates, “BlackRock”).&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer\&quot;&gt;Although BlackRock shall obtain data from sources that BlackRock considers reliable, all data contained herein is provided “as is” and BlackRock makes no representation or warranty of any kind, either express or implied, with respect to such data, the timeliness thereof, the results to be obtained by the use thereof or any other matter. BlackRock expressly disclaims any and all implied warranties, including without limitation, warranties of originality, accuracy, completeness, timeliness, non-infringement, merchantability and fitness for a particular purpose.&lt;/p&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;BlackRock provides compensation in connection with obtaining or using third-party ratings and rankings.&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer\&quot;&gt;The iShares Funds are not sponsored, endorsed, issued, sold or promoted by Bloomberg, BlackRock Index Services, LLC, Cboe Global Indices, LLC, Cohen &amp;amp; Steers, European Public Real Estate Association (“EPRA® ”), FTSE International Limited (“FTSE”), ICE Data Indices, LLC, NSE Indices Ltd, JPMorgan, JPX Group, London Stock Exchange Group (“LSEG”), MSCI Inc., Markit Indices Limited, Morningstar, Inc., Nasdaq, Inc., National Association of Real Estate Investment Trusts (“NAREIT”), Nikkei, Inc., Russell, S&amp;amp;P Dow Jones Indices LLC or STOXX Ltd. None of these companies make any representation regarding the advisability of investing in the Funds. With the exception of BlackRock Index Services, LLC, who is an affiliate, BlackRock Investments, LLC is not affiliated with the companies listed above.&lt;/p&gt;\n&lt;p class=\&quot;disclaimer\&quot;&gt;Neither FTSE, LSEG, nor NAREIT makes any warranty regarding the FTSE Nareit Equity REITS Index, FTSE Nareit All Residential Capped Index or FTSE Nareit All Mortgage Capped Index. Neither FTSE, EPRA, LSEG, nor NAREIT makes any warranty regarding the FTSE EPRA Nareit Developed ex-U.S. Index, FTSE EPRA Nareit Developed Green Target Index or FTSE EPRA Nareit Global REITs Index. “FTSE®” is a trademark of London Stock Exchange Group companies and is used by FTSE under license.&lt;/p&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;a name=\&quot;esg-footer\&quot;&gt;&lt;/a&gt;\n&lt;p class=\&quot;disclaimer\&quot;&gt;For funds with an investment objective that include the integration of ESG criteria, there may be corporate actions or other situations that may cause the fund or index to passively hold securities that may not comply with ESG criteria. Please refer to the fund’s prospectus for more information. The screening applied by the fund&#x27;s index provider may include revenue thresholds set by the index provider. The information displayed on this website may not include all of the screens that apply to the relevant index or the relevant fund. These screens are described in more detail in the fund’s prospectus, other fund documents, and the relevant index methodology document.&lt;/p&gt;\n&lt;p class=\&quot;disclaimer\&quot;&gt;Review the MSCI methodology behind the Sustainability Characteristics and Business Involvement metrics: &lt;a href=\&quot;https://www.msci.com/esg-fund-ratings\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;1&lt;/sup&gt;ESG Fund Ratings&lt;/a&gt;; &lt;a href=\&quot;https://www.msci.com/index-carbon-footprint-metrics\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;2&lt;/sup&gt;Index Carbon Footprint Metrics&lt;/a&gt;; &lt;a href=\&quot;https://www.msci.com/documents/1296102/1636401/MSCI_ESG_BIS_Research_Productsheet_April+2015.pdf/babff66f-d1d6-4308-b63d-57fb7c5ccfa9\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;3&lt;/sup&gt;Business Involvement Screening Research&lt;/a&gt;; &lt;a href=\&quot;https://www.msci.com/indexes/documents/methodology/2_MSCI_Screened_Indexes_Methodology_20241230.pdf\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;4&lt;/sup&gt;ESG Screened Index Methodology&lt;/a&gt;; &lt;a href=\&quot;https://www.msci.com/documents/10199/acbe7c8a-a4e4-49de-9cf8-5e957245b86b\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;5&lt;/sup&gt;ESG Controversies&lt;/a&gt;; &lt;a href=\&quot;https://www.msci.com/documents/1296102/27422075/ImpliedTemperatureRise-cfs-en.pdf\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;&lt;sup&gt;6&lt;/sup&gt;MSCI Implied Temperature Rise&lt;/a&gt;&lt;/p&gt;\n&lt;p class=\&quot;disclaimer\&quot;&gt;Certain information contained herein (the “Information”) has been provided by MSCI ESG Research LLC, a RIA under the Investment Advisers Act of 1940, and may include data from its affiliates (including MSCI Inc. and its subsidiaries (“MSCI”)), or third party suppliers (each an “Information Provider”), and it may not be reproduced or redisseminated in whole or in part without prior written permission. The Information has not been submitted to, nor received approval from, the US SEC or any other regulatory body. The Information may not be used to create any derivative works, or in connection with, nor does it constitute, an offer to buy or sell, or a promotion or recommendation of, any security, financial instrument or product or trading strategy, nor should it be taken as an indication or guarantee of any future performance, analysis, forecast or prediction. Some funds may be based on or linked to MSCI indexes, and MSCI may be compensated based on the fund’s assets under management or other measures. MSCI has established an information barrier between equity index research and certain Information. None of the Information in and of itself can be used to determine which securities to buy or sell or when to buy or sell them. The Information is provided “as is” and the user of the Information assumes the entire risk of any use it may make or permit to be made of the Information. Neither MSCI ESG Research nor any Information Party makes any representations or express or implied warranties (which are expressly disclaimed), nor shall they incur liability for any errors or omissions in the Information, or for any damages related thereto. The foregoing shall not exclude or limit any liability that may not by applicable law be excluded or limited.&lt;/p&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p class=\&quot;disclaimer\&quot;&gt;© 2026 BlackRock, Inc. &lt;strong&gt;BLACKROCK, BLACKROCK SOLUTIONS, BUILD ON BLACKROCK, ALADDIN, iSHARES, iBONDS, FACTORSELECT, iTHINKING, iSHARES CONNECT, FUND FRENZY, LIFEPATH, SO WHAT DO I DO WITH MY MONEY, INVESTING FOR A NEW WORLD, BUILT FOR THESE TIMES,&lt;/strong&gt; the iShares Core Graphic,&lt;strong&gt; CoRI &lt;/strong&gt;and the &lt;strong&gt;CoRI &lt;/strong&gt;logo are trademarks of BlackRock, Inc., or its subsidiaries in the United States and elsewhere. All other marks are the property of their respective owners.&lt;/p&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;div&gt;T&amp;amp;O0525-5344722-EXP0528&lt;/div&gt;&quot;},{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;p&gt;MKTG0926-MH-5938540-EXP0927&lt;/p&gt;&quot;}],&quot;product-risks-title&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;&lt;div class=\&quot;fund-component\&quot;&gt;\n&lt;h2 class=\&quot;mobile-hidden\&quot; data-link-target=\&quot;\&quot;&gt;Key Risks&lt;/h2&gt;&lt;/div&gt;&quot;}],&quot;product_structure.physical&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Physical&quot;}],&quot;product_structure.synthetic&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Synthetic&quot;}],&quot;red-oak-footer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;501848&quot;}],&quot;release-testing&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;ROhit - fred.investorClassCode USD &lt;br /&gt;Product Gross Return - fred.grossReturn After Cost - fred.longModerateFelBelAnn &lt;br /&gt;Front Cost - fred.frontCostAmt Front Pct - fred.frontCostPercent Prospectus Name - fred.fundProspectusName &lt;br /&gt;Short Name - fred.investorClassCode USD &lt;br /&gt;ISin - US4642874329    RHP - &lt;recommendedHoldingPeriod/&gt;&quot;}],&quot;risk-indicator.disclaimer&quot;:[],&quot;risk_profile.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;Based on the 1 year standard deviation of the fund. Standard deviation measures how dispersed returns are around the average. A higher standard deviation indicates that returns are spread out over a larger range of values and thus, more volatile or risky. Each increment on the scale above represents a 5% range of standard deviation except for the last segment which is &amp;gt;20%.&quot;}],&quot;search-card.contacts&quot;:[],&quot;search-card.positioning&quot;:[],&quot;sec-lending.summary.disclaimer&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;The above table summarises the lending data available for the fund.&lt;br /&gt;&lt;br /&gt;The information in the Lending Summary table will not be displayed for the funds that have participated in securities lending for less than 12 months. The figures shown relate to past performance. Past performance is not a reliable indication of current or future results.&lt;br /&gt;BlackRock’s policy is to disclose performance information quarterly subject to a one-month delay. This means that returns from 01/01/2019 to 31/12/2019 can be publicly disclosed from 01/02/2020.&lt;br /&gt;&lt;br /&gt;Maximum on-loan figure may increase or decrease over time.&lt;br /&gt;&lt;br /&gt;&lt;span&gt;With securities lending there is a risk of loss should the borrower default before the securities are returned, and due to market movements, the value of collateral held has fallen and/or the value of the securities on loan has risen.&lt;/span&gt;&quot;}],&quot;section-headers.cumulative-performance&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;CUMULATIVE &amp;amp; ANNUALISED PERFORMANCE&quot;}],&quot;section_headers.annual_performance&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;CUMULATIVE &amp;amp; ANNUALISED PERFORMANCE&quot;}],&quot;section_headers.asset_allocation_breakdown&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;ASSET ALLOCATION (%)&quot;}],&quot;section_headers.asset_type_breakdown&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;ASSET TYPE BREAKDOWN (%)&quot;}],&quot;section_headers.breakdown_of_fees_and_expenses&quot;:[{&quot;metadata&quot;:null,&quot;text&quot;:&quot;FEES AND EXPENSES BREAKDOWN&quot;}],&quot;sectio