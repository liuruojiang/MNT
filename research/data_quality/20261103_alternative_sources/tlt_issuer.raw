eyFundFacts-indexSeriesName">ICE US Treasury 20+ Year Bond Index</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-investmentStyle"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-investmentStyle-label"><span>Investment<!-- --> </span><span class="_ws-lastword-and-tip"><span>Style</span><span class="_ws-tip-inline"><span class="_ws-info-bubble-container _ws-v3design"><button id="infoBubble-db81f8f8-aed3-410c-b3c0-82d9435e24de" class="_ws-product-info-bubble _ws-v3design" aria-haspopup="true" aria-label="Investment Style More Info" aria-expanded="false" data-id="keyFundFacts-investmentStyle-infoBubble" webqc-datapoint="keyFundFacts-investmentStyle-infoBubble" title="Active Funds do not seek to replicate the performance of a specified index and the management team has discretion to manage the Fund’s portfolio in accordance with the Fund’s investment objectives. Index Funds seek to track the investment results of their underlying index."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></span></span></span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-investmentStyle-data" webqc-datapoint="keyFundFacts-investmentStyle">Index</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-distributionFrequency"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-distributionFrequency-label"><span>Distribution<!-- --> </span><span class="_ws-lastword-and-tip"><span>Frequency</span><span class="_ws-tip-inline"><span class="_ws-info-bubble-container _ws-v3design"><button id="infoBubble-835f8d89-f3e9-4880-b469-6fee5851ce5a" class="_ws-product-info-bubble _ws-v3design" aria-haspopup="true" aria-label="Distribution Frequency More Info" aria-expanded="false" data-id="keyFundFacts-distributionFrequency-infoBubble" webqc-datapoint="keyFundFacts-distributionFrequency-infoBubble" title="How often a distribution is paid by the fund. The most common distribution frequencies are annually, biannually and quarterly."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></span></span></span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-distributionFrequency-data" webqc-datapoint="keyFundFacts-distributionFrequency">Monthly</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-cusip"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-cusip-label">CUSIP</span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-cusip-data" webqc-datapoint="keyFundFacts-cusip">464287432</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-thirtyDayAverageVolume"><div class="_ws-_d1_1pwdg_43 _ws-"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-thirtyDayAverageVolume-label"><span>30 Day Avg.<!-- --> </span><span class="_ws-lastword-and-tip"><span>Volume</span><span class="_ws-tip-inline"><span class="_ws-info-bubble-container _ws-v3design"><button id="infoBubble-a52415be-6769-4fb4-98e5-6383d4cde32b" class="_ws-product-info-bubble _ws-v3design" aria-haspopup="true" aria-label="30 Day Avg. Volume More Info" aria-expanded="false" data-id="keyFundFacts-thirtyDayAverageVolume-infoBubble" webqc-datapoint="keyFundFacts-thirtyDayAverageVolume-infoBubble" title="The average number of shares traded in a security across all U.S. exchanges over the last 30 calendar days."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></span></span></span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-thirtyDayAverageVolume-data" webqc-datapoint="keyFundFacts-thirtyDayAverageVolume">41,386,667.00</span></div><div class="_ws-oneds-body-xs-compact _ws-_d3_1pwdg_60" webqc-datapoint="keyFundFacts-thirtyDayAverageVolume-asOf" data-id="keyFundFacts-thirtyDayAverageVolume-asOf">as of<!-- --> <!-- -->Oct 30, 2026</div></div></div><div role="list" class="_ws-_dataList_1pwdg_25 _ws-_reverseStripe_1pwdg_78 _ws-_firstDataListEven_1pwdg_85" data-id="keyFundFacts-table-right-column"><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-launchDate"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-launchDate-label">Fund Inception</span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-launchDate-data" webqc-datapoint="keyFundFacts-launchDate">Jul 22, 2002</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-assetClass"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-assetClass-label">Asset Class</span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-assetClass-data" webqc-datapoint="keyFundFacts-assetClass">Fixed Income</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-indexTicker"><div class="_ws-_d1_1pwdg_43 _ws-_singleItem_1pwdg_48"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-indexTicker-label">Bloomberg Index Ticker</span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-indexTicker-data" webqc-datapoint="keyFundFacts-indexTicker">IDCOT20</span></div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-sharesOutstanding"><div class="_ws-_d1_1pwdg_43 _ws-"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-sharesOutstanding-label">Shares Outstanding</span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-sharesOutstanding-data" webqc-datapoint="keyFundFacts-sharesOutstanding">585,900,000</span></div><div class="_ws-oneds-body-xs-compact _ws-_d3_1pwdg_60" webqc-datapoint="keyFundFacts-sharesOutstanding-asOf" data-id="keyFundFacts-sharesOutstanding-asOf">as of<!-- --> <!-- -->Nov 02, 2026</div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-premiumDiscountClosingPriceNavPercent"><div class="_ws-_d1_1pwdg_43 _ws-"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-premiumDiscountClosingPriceNavPercent-label"><span></span><span class="_ws-lastword-and-tip"><span>Premium/Discount</span><span class="_ws-tip-inline"><span class="_ws-info-bubble-container _ws-v3design"><button id="infoBubble-64e23d8e-59f4-452f-81bb-00f68ed4611c" class="_ws-product-info-bubble _ws-v3design" aria-haspopup="true" aria-label="Premium/Discount More Info" aria-expanded="false" data-id="keyFundFacts-premiumDiscountClosingPriceNavPercent-infoBubble" webqc-datapoint="keyFundFacts-premiumDiscountClosingPriceNavPercent-infoBubble" title="The amount the fund’s closing price is trading above or below the reported NAV, expressed as a percentage of the NAV. When the fund’s closing price is greater than the fund’s NAV, it is said to be trading at a “premium” and the percentage is expressed as a positive number. When the fund’s closing price is less than the fund’s NAV, it is said to be trading at a “discount” and the percentage is expressed as a negative number."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></span></span></span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-premiumDiscountClosingPriceNavPercent-data" webqc-datapoint="keyFundFacts-premiumDiscountClosingPriceNavPercent">0.05</span></div><div class="_ws-oneds-body-xs-compact _ws-_d3_1pwdg_60" webqc-datapoint="keyFundFacts-premiumDiscountClosingPriceNavPercent-asOf" data-id="keyFundFacts-premiumDiscountClosingPriceNavPercent-asOf">as of<!-- --> <!-- -->Oct 30, 2026</div></div><div role="listitem" class="_ws-_item_1pwdg_33" data-id="keyFundFacts-row-thirtyDayMedianBidAskSpread"><div class="_ws-_d1_1pwdg_43 _ws-"><span class="_ws-oneds-body-s-compact" data-id="keyFundFacts-thirtyDayMedianBidAskSpread-label"><span>30 Day Median Bid/Ask<!-- --> </span><span class="_ws-lastword-and-tip"><span>Spread</span><span class="_ws-tip-inline"><span class="_ws-info-bubble-container _ws-v3design"><button id="infoBubble-3a0f5832-4054-4df6-883f-a827b1d6bd66" class="_ws-product-info-bubble _ws-v3design" aria-haspopup="true" aria-label="30 Day Median Bid/Ask Spread More Info" aria-expanded="false" data-id="keyFundFacts-thirtyDayMedianBidAskSpread-infoBubble" webqc-datapoint="keyFundFacts-thirtyDayMedianBidAskSpread-infoBubble" title="The median bid-ask spread is calculated by identifying the national best bid and national best offer (&quot;NBBO&quot;) for each fund as of the end of each 10 second interval during each trading day of the last 30 calendar days and dividing the difference between each such bid and offer by the midpoint of the NBBO. The median of those values is identified and that value is expressed as a percentage rounded to the nearest hundredth."><svg width="16" height="16" viewBox="0 0 18 16" fill="none" xmlns="http://www.w3.org/2000/svg"><g id="Circle-info"><path id="Vector" d="M8 16C10.1217 16 12.1566 15.1571 13.6569 13.6569C15.1571 12.1566 16 10.1217 16 8C16 5.87827 15.1571 3.84344 13.6569 2.34315C12.1566 0.842855 10.1217 0 8 0C5.87827 0 3.84344 0.842855 2.34314 2.34315C0.842853 3.84344 0 5.87827 0 8C0 10.1217 0.842853 12.1566 2.34314 13.6569C3.84344 15.1571 5.87827 16 8 16ZM6.75 10.5H7.5V8.5H6.75H6V7H6.75H8.25H9V7.75V10.5H9.25H10V12H9.25H6.75H6V10.5H6.75ZM9 6H7V4H9V6Z" fill="black"></path></g></svg></button></span></span></span></span></div><div class="_ws-_d2_1pwdg_51"><span class="_ws-oneds-body-m-compact-bold" data-id="keyFundFacts-thirtyDayMedianBidAskSpread-data" webqc-datapoint="keyFundFacts-thirtyDayMedianBidAskSpread">0.01%</span></div><div class="_ws-oneds-body-xs-compact _ws-_d3_1pwdg_60" webqc-datapoint="keyFundFacts-thirtyDayMedianBidAskSpread-asOf" data-id="keyFundFacts-thirtyDayMedianBidAskSpread-asOf">as of<!-- --> <!-- -->Oct 30, 2026</div></div></div></div></div><div class="_ws-_disclaimerContainer_1tn1h_9"><div class="" data-disclaimer-fragment="key-fund-facts.disclaimer"><div class="_ws-_disclaimerText_1tn1h_29"><div class="_ws-_disclaimerTextParagraphContainer_1tn1h_32"><p class="_ws-oneds-body-s _ws-oneds-body-s-italic"><a href="https://www.ishares.com/us/literature/investor-guide/naic-bond-preferred-stock-etfs.pdf" target="_blank" rel="noopener" class="_ws-oneds-body-s-link">iShares ETFs with Preliminary NAIC Designations and final NAIC Designations</a></p></div></div></div></div></div></div></walrus-render-on-client></div><div data-componentname="LadderedBufferV3"></div><div data-componentname="StrategyCharacteristicsV3"></div><div data-componentname="ScenarioAnalysisV3"></div><div data-componentname="PortfolioCharacteristicsV3"><walrus-render-on-client componenttype="on-server-first" componentprops="{&quot;componentId&quot;:&quot;fundamentalsAndRisk&quot;,&quot;rocPct&quot;:{&quot;value&quot;:&quot;-&quot;,&quot;asOfDate&quot;:&quot;-&quot;},&quot;rocPct12Month&quot;:{&quot;value&quot;:&quot;-&quot;,&quot;asOfDate&quot;:&quot;-&quot;},&quot;containersByNameMap&quot;:{&quot;default&quot;:{&quot;name&quot;:&quot;default&quot;,&quot;fullName&quot;:&quot;fundamentalsAndRisk.default&quot;,&quot;visible&quot;:true,&quot;sortIndex&quot;:-1,&quot;sortOrder&quot;:null,&quot;properties&quot;:{},&quot;dataPointsByNameMap&quot;:{&quot;beta3Yr&quot;:{&quot;name&quot;:&quot;beta3Yr&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:28,&quot;asOfDate&quot;:20260930,&quot;formattedAsOfDate&quot;:&quot;Sep 30, 2026&quot;,&quot;formattedValue&quot;:&quot;0.54&quot;,&quot;label&quot;:&quot;Equity Beta (3y)&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;Beta is a measure of the tendency of securities to move with the market as a whole. A beta of 1 indicates that the security&amp;#39;s price will move with the market. A beta less than 1 indicates the security tends to be less volatile than the market, while a beta greater than 1 indicates the security is more volatile than the market.&lt;br/&gt;&lt;br/&gt;Calculated vs. S&amp;amp;P 500&quot;,&quot;prefix&quot;:null,&quot;value&quot;:0.5422,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.beta3Yr&quot;},&quot;convexity&quot;:{&quot;name&quot;:&quot;convexity&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:141,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;3.13&quot;,&quot;label&quot;:&quot;Convexity&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;Convexity measures the change in duration for a given change in rates. Positive convexity indicates that duration lengthens when rates fall and contracts when rates rise; negative convexity indicates that duration contracts when rates fall and increases when rates rise.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:3.1265,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.convexity&quot;},&quot;fxHedgedYield&quot;:{&quot;name&quot;:&quot;fxHedgedYield&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:72,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;5.34%&quot;,&quot;label&quot;:&quot;Average Yield to Maturity&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;Yield to Maturity is the discount rate that equates the present value of a bond&amp;#39;s cash flows with its market price (including accrued interest). For callable bonds, this yield is the yield to worst. For TIPS, this yield includes the market&amp;#39;s estimates for inflation over the life of the bond. For FX positions, this yield includes the carry yield from currency positions, calculated based on an estimated annualized 1m forward contract. The measure does not include fees and expenses.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:5.34,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.fxHedgedYield&quot;},&quot;modelOad&quot;:{&quot;name&quot;:&quot;modelOad&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:128,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;14.83 yrs&quot;,&quot;label&quot;:&quot;Effective Duration&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;Effective Duration measures the sensitivity of the price of a bond with or without embedded options to changes in interest rates, taking into account the likelihood of the bond being called, put and/or sunk prior to its final maturity date while incorporating after-tax impacts on the bond. The options-based duration model used by BlackRock employs certain assumptions and may differ from other fund complexes. Effective Duration is measured at the individual bond level, aggregated to the portfolio level, and adjusted for leverage, hedging transactions and non-bond holdings, including derivatives.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:14.83463,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.modelOad&quot;},&quot;numHoldings&quot;:{&quot;name&quot;:&quot;numHoldings&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:3,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;47&quot;,&quot;label&quot;:&quot;Number of Holdings&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;The number of holdings in the fund excluding cash positions and derivatives such as futures and currency forwards.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:47,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.numHoldings&quot;},&quot;optionAdjustedSpread&quot;:{&quot;name&quot;:&quot;optionAdjustedSpread&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:142,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;-0.13 bps&quot;,&quot;label&quot;:&quot;Option Adjusted Spread&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;The weighted average incremental yield earned over similar duration matched US Treasuries for taxable fixed income or the AAA-rated Municipal Yield Curve for tax-exempt municipals, measured in basis points (one basis point is equivalent to 0.01% or 0.0001). This metric considers the likelihood that bonds will be called or prepaid before the scheduled maturity date.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:-0.13191,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.optionAdjustedSpread&quot;},&quot;rocPct&quot;:{&quot;name&quot;:&quot;rocPct&quot;,&quot;visible&quot;:false,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:false,&quot;sortOrder&quot;:null,&quot;asOfDate&quot;:null,&quot;formattedAsOfDate&quot;:null,&quot;formattedValue&quot;:&quot;-&quot;,&quot;label&quot;:&quot;&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;prefix&quot;:null,&quot;value&quot;:null,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.rocPct&quot;},&quot;rocPct12Month&quot;:{&quot;name&quot;:&quot;rocPct12Month&quot;,&quot;visible&quot;:false,&quot;active&quot;:true,&quot;asOf&quot;:false,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:false,&quot;sortOrder&quot;:null,&quot;asOfDate&quot;:null,&quot;formattedAsOfDate&quot;:null,&quot;formattedValue&quot;:&quot;-&quot;,&quot;label&quot;:&quot;&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;&quot;,&quot;prefix&quot;:null,&quot;value&quot;:null,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.rocPct12Month&quot;},&quot;standardDeviation3Yr&quot;:{&quot;name&quot;:&quot;standardDeviation3Yr&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:31,&quot;asOfDate&quot;:20260930,&quot;formattedAsOfDate&quot;:&quot;Sep 30, 2026&quot;,&quot;formattedValue&quot;:&quot;13.35%&quot;,&quot;label&quot;:&quot;Standard Deviation (3y)&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;Standard deviation measures how dispersed returns are around the average. A higher standard deviation indicates that returns are spread out over a larger range of values and thus, more volatile.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:13.3478,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.standardDeviation3Yr&quot;},&quot;thirtyDaySecYield&quot;:{&quot;name&quot;:&quot;thirtyDaySecYield&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:29,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;5.29%&quot;,&quot;label&quot;:&quot;30 Day SEC Yield&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;A standard calculation of yield introduced by the SEC in order to provide fairer comparison among funds. This yield reflects the interest earned after deducting the fund&amp;#39;s expenses during the most recent 30-day period by the average investor in the fund. Negative 30-Day SEC Yield results when accrued expenses of the past 30 days exceed the income collected during the past 30 days.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:5.2896,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.thirtyDaySecYield&quot;},&quot;twelveMonTrlYld&quot;:{&quot;name&quot;:&quot;twelveMonTrlYld&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:30,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;4.76%&quot;,&quot;label&quot;:&quot;12m Trailing Yield&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;The yield an investor would have received if they had held the fund over the last twelve months assuming the most recent NAV. The 12-Month yield is calculated by assuming any income distributions over the past twelve months and dividing by the sum of the most recent NAV and any capital gain distributions made over the past twelve months.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:4.757095,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.twelveMonTrlYld&quot;},&quot;weightedAvgCouponFi&quot;:{&quot;name&quot;:&quot;weightedAvgCouponFi&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:84,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;3.38&quot;,&quot;label&quot;:&quot;Weighted Avg Coupon&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;The average coupon rate of the underlying bonds in the fund, weighted by each bond&amp;#39;s face value.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:3.37625,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.weightedAvgCouponFi&quot;},&quot;weightedAvgLife&quot;:{&quot;name&quot;:&quot;weightedAvgLife&quot;,&quot;visible&quot;:true,&quot;active&quot;:true,&quot;asOf&quot;:true,&quot;hideNullData&quot;:false,&quot;mobileEnabled&quot;:true,&quot;sortOrder&quot;:127,&quot;asOfDate&quot;:20261030,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;formattedValue&quot;:&quot;25.94 yrs&quot;,&quot;label&quot;:&quot;Weighted Avg Maturity&quot;,&quot;asOfLabel&quot;:&quot;&quot;,&quot;infoBubble&quot;:&quot;The average length of time to the repayment of principal for the securities in the fund. This metric considers the likelihood that bonds will be called or prepaid before the scheduled maturity date.&quot;,&quot;prefix&quot;:null,&quot;value&quot;:25.94,&quot;returnType&quot;:false,&quot;associatedReturnType&quot;:false,&quot;fullName&quot;:&quot;fundamentalsAndRisk.weightedAvgLife&quot;}},&quot;hasData&quot;:true,&quot;subContainersByNameMap&quot;:{},&quot;default&quot;:true,&quot;granted&quot;:true}},&quot;dataPoints&quot;:{&quot;beta3Yr&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Equity Beta (3y)&quot;,&quot;formattedValue&quot;:&quot;0.54&quot;,&quot;sortOrder&quot;:28,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Beta is a measure of the tendency of securities to move with the market as a whole. A beta of 1 indicates that the security&amp;#39;s price will move with the market. A beta less than 1 indicates the security tends to be less volatile than the market, while a beta greater than 1 indicates the security is more volatile than the market.&lt;br/&gt;&lt;br/&gt;Calculated vs. S&amp;amp;P 500&quot;,&quot;formattedAsOfDate&quot;:&quot;Sep 30, 2026&quot;,&quot;name&quot;:&quot;beta3Yr&quot;},&quot;convexity&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Convexity&quot;,&quot;formattedValue&quot;:&quot;3.13&quot;,&quot;sortOrder&quot;:141,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Convexity measures the change in duration for a given change in rates. Positive convexity indicates that duration lengthens when rates fall and contracts when rates rise; negative convexity indicates that duration contracts when rates fall and increases when rates rise.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;convexity&quot;},&quot;fxHedgedYield&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Average Yield to Maturity&quot;,&quot;formattedValue&quot;:&quot;5.34%&quot;,&quot;sortOrder&quot;:72,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Yield to Maturity is the discount rate that equates the present value of a bond&amp;#39;s cash flows with its market price (including accrued interest). For callable bonds, this yield is the yield to worst. For TIPS, this yield includes the market&amp;#39;s estimates for inflation over the life of the bond. For FX positions, this yield includes the carry yield from currency positions, calculated based on an estimated annualized 1m forward contract. The measure does not include fees and expenses.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;fxHedgedYield&quot;},&quot;modelOad&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Effective Duration&quot;,&quot;formattedValue&quot;:&quot;14.83 yrs&quot;,&quot;sortOrder&quot;:128,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Effective Duration measures the sensitivity of the price of a bond with or without embedded options to changes in interest rates, taking into account the likelihood of the bond being called, put and/or sunk prior to its final maturity date while incorporating after-tax impacts on the bond. The options-based duration model used by BlackRock employs certain assumptions and may differ from other fund complexes. Effective Duration is measured at the individual bond level, aggregated to the portfolio level, and adjusted for leverage, hedging transactions and non-bond holdings, including derivatives.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;modelOad&quot;},&quot;numHoldings&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Number of Holdings&quot;,&quot;formattedValue&quot;:&quot;47&quot;,&quot;sortOrder&quot;:3,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The number of holdings in the fund excluding cash positions and derivatives such as futures and currency forwards.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;numHoldings&quot;},&quot;optionAdjustedSpread&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Option Adjusted Spread&quot;,&quot;formattedValue&quot;:&quot;-0.13 bps&quot;,&quot;sortOrder&quot;:142,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The weighted average incremental yield earned over similar duration matched US Treasuries for taxable fixed income or the AAA-rated Municipal Yield Curve for tax-exempt municipals, measured in basis points (one basis point is equivalent to 0.01% or 0.0001). This metric considers the likelihood that bonds will be called or prepaid before the scheduled maturity date.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;optionAdjustedSpread&quot;},&quot;standardDeviation3Yr&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Standard Deviation (3y)&quot;,&quot;formattedValue&quot;:&quot;13.35%&quot;,&quot;sortOrder&quot;:31,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;Standard deviation measures how dispersed returns are around the average. A higher standard deviation indicates that returns are spread out over a larger range of values and thus, more volatile.&quot;,&quot;formattedAsOfDate&quot;:&quot;Sep 30, 2026&quot;,&quot;name&quot;:&quot;standardDeviation3Yr&quot;},&quot;thirtyDaySecYield&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;30 Day SEC Yield&quot;,&quot;formattedValue&quot;:&quot;5.29%&quot;,&quot;sortOrder&quot;:29,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;A standard calculation of yield introduced by the SEC in order to provide fairer comparison among funds. This yield reflects the interest earned after deducting the fund&amp;#39;s expenses during the most recent 30-day period by the average investor in the fund. Negative 30-Day SEC Yield results when accrued expenses of the past 30 days exceed the income collected during the past 30 days.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;thirtyDaySecYield&quot;},&quot;twelveMonTrlYld&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;12m Trailing Yield&quot;,&quot;formattedValue&quot;:&quot;4.76%&quot;,&quot;sortOrder&quot;:30,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The yield an investor would have received if they had held the fund over the last twelve months assuming the most recent NAV. The 12-Month yield is calculated by assuming any income distributions over the past twelve months and dividing by the sum of the most recent NAV and any capital gain distributions made over the past twelve months.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;twelveMonTrlYld&quot;},&quot;weightedAvgCouponFi&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Weighted Avg Coupon&quot;,&quot;formattedValue&quot;:&quot;3.38&quot;,&quot;sortOrder&quot;:84,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The average coupon rate of the underlying bonds in the fund, weighted by each bond&amp;#39;s face value.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;weightedAvgCouponFi&quot;},&quot;weightedAvgLife&quot;:{&quot;visible&quot;:true,&quot;label&quot;:&quot;Weighted Avg Maturity&quot;,&quot;formattedValue&quot;:&quot;25.94 yrs&quot;,&quot;sortOrder&quot;:127,&quot;prefix&quot;:null,&quot;infoBubble&quot;:&quot;The average length of time to the repayment of principal for the securities in the fund. This metric considers the likelihood that bonds will be called or prepaid before the scheduled maturity date.&quot;,&quot;formattedAsOfDate&quot;:&quot;Oct 30, 2026&quot;,&quot;name&quot;:&quot;weightedAvgLife&quot;}}}" componentkey="PortfolioCharacteristicsV3"><div webqc-datapoint="fundamentalsAndRisk" class="_ws-fund-component _ws-fund-component-container _ws-v3 _ws-full-bleed" data-id="fundamentalsAndRisk-container" data-componentname="fundamentalsAndRisk" role="region" aria-labelledby="fundamentalsAndRisk-header" tabindex="-1"><div class="_ws-container-fluid"><div class="_ws-headline-container _ws-fluid-l"><h2 class="_ws-headline _ws-oneds-heading-l _ws-oneds-overridden-heading-l" data-id="fundamentalsAndRisk-header" webqc-datapoint="fundamentalsAndRisk-header" id="fundamentalsAndRisk-header" data-link-target="">Portfolio Characteristics</h2></div><div class="_ws-_cardDataListContainer_1v8bz_25"><div class="_ws-_card_1v8bz_25" data-id="fundamentalsAndRisk-cards"><div class="_ws-pp-card _ws-card-section" data-id="fundamentalsAndRisk-row-numHoldings"><div class="_ws-pp-card-item"><span class="_ws-one